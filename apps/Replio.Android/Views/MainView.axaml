<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Replio.Avalonia.Views.Controls"
             xmlns:views="using:Replio.Android.Views"
             xmlns:platform="using:Replio.Android.Platform"
             xmlns:vm="using:ReplioDesktop.ViewModels"
             xmlns:models="using:ReplioDesktop.Models"
             x:Class="Replio.Android.Views.MainView"
             x:CompileBindings="False"
             Background="{DynamicResource EchoBgBrush}"
             Foreground="{DynamicResource EchoTextBrush}"
             FontFamily="{StaticResource EchoFont}"
             FontSize="15">
    <!-- Phone layout of the Windows pages: Home (groups, sessions and a group's pages), a session, settings.
         Made for fingers (Material guidelines): a bottom bar for the two places, a big record button, touch targets of
         48 px, press and hold for the actions of a card, a chip or a hint, text from 15 px and 18 px for hints during a
         recording. Colours, fonts and controls are the Echo ones of the desktop apps. -->
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <!-- A press sinks the button a little and lets it spring back, instead of a jump. -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <!-- A new hint, question or note in the live list rises in softly. -->
        <Style Selector="Panel.chatItem">
            <Style.Animations>
                <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="16" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Long labels on narrow phones go to a second line instead of being cut. -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sessionCard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.questionHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="15.5" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="0,22,0,6" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section:nth-child(1)">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource EchoSoftTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.settingsCard">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
        </Style>
        <!-- Record button over the Home list. -->
        <Style Selector="Button.fab">
            <Setter Property="Height" Value="56" />
            <Setter Property="MinWidth" Value="172" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EchoAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoAccentInkBrush}" />
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="18" OffsetX="0" OffsetY="5" Opacity="0.32" Color="#000000" />
            </Setter>
        </Style>
        <Style Selector="Button.fab.live">
            <Setter Property="Background" Value="{DynamicResource EchoDangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoDangerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Bottom bar items: icon in a pill that lights up for the open place, label under it. -->
        <Style Selector="Button.navItem">
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
        </Style>
        <Style Selector="Button.navItem Border.navIcon">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.navItem.active Border.navIcon">
            <Setter Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.navItem Path">
            <Setter Property="Stroke" Value="{DynamicResource EchoMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navItem.active Path">
            <Setter Property="Stroke" Value="{DynamicResource EchoAccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.navLabel">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
        </Style>
        <Style Selector="Button.navItem.active TextBlock.navLabel">
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Button.dangerSoft">
            <Setter Property="Background" Value="{DynamicResource EchoDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoDangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.graphZoom">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{DynamicResource EchoHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Topic chips: a horizontal row instead of the desktop sidebar. -->
        <Style Selector="ListBox#TopicChips ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.topicChip">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.topicChip">
            <Setter Property="Background" Value="{DynamicResource EchoSelectedTabBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Pill tabs of a session and of a topic. -->
        <Style Selector="RadioButton.pill">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Pill"
                            Padding="16,0"
                            MinHeight="44"
                            CornerRadius="22"
                            BorderThickness="1"
                            Background="{DynamicResource EchoSurfaceAltBrush}"
                            BorderBrush="{DynamicResource EchoBorderBrush}">
                        <ContentPresenter VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource EchoTextBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.pill:checked /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource EchoSelectedTabBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
        </Style>
        <!-- Hint dialog bubbles, like the overlay on the desktop. -->
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="16,16,16,4" />
        </Style>
        <Style Selector="Border.bubble.user">
            <Setter Property="Background" Value="{DynamicResource EchoUserBubbleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="16,16,4,16" />
        </Style>
        <Style Selector="TextBlock.role">
            <Setter Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.role.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.knowledgeStatus">
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.knowledgeStatus.fresh, TextBlock.knowledgeStatus.changed">
            <Setter Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.knowledgeStatus.failed">
            <Setter Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
        </Style>
        <Style Selector="TextBlock.staleStatus">
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.staleStatus.stale">
            <Setter Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Path.chevron">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Path.chevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="TextBlock.costLabel.total">
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.costValue.total">
            <Setter Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Screen-share badge: always «Скрыт от демонстрации»; mint with a lit dot while hidden, plain with a grey dot while visible. -->
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.quick">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.monitor">
            <Setter Property="Foreground" Value="{DynamicResource EchoBadgeTextBrush}" />
        </Style>
        <Style Selector="TextBlock.monitor.problem">
            <Setter Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource EchoAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceAltBrush}" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Underline tabs (Material tabs) for the pages of a group and of a finished session: unlike the group
             chips above them they read as «pages», not as one more row of buttons. -->
        <Style Selector="RadioButton.tab">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" RowDefinitions="*,Auto">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Margin="14,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource EchoMutedBrush}" />
                        <Border Name="Indicator" Grid.Row="1" Height="3" Margin="10,0" CornerRadius="2,2,0,0" Background="Transparent" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ Border#Indicator">
            <Setter Property="Background" Value="{DynamicResource EchoAccentBrush}" />
        </Style>
        <!-- Two big halves on the recording screen: «Подсказки» | «Текст». -->
        <Style Selector="RadioButton.segment">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Segment" MinHeight="44" CornerRadius="22" Background="Transparent">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource EchoMutedBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#Segment">
            <Setter Property="Background" Value="{DynamicResource EchoSelectedTabBrush}" />
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
        </Style>
        <!-- Calls in the app bar: «● Ждёт звонка», «Настроить звонки», «● 03:12» while recording. -->
        <Style Selector="Button.callPill">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0,14,0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
        </Style>
        <Style Selector="Button.callPill.todo">
            <Setter Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
        </Style>
        <Style Selector="Button.callPill.live">
            <Setter Property="Background" Value="{DynamicResource EchoDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoDangerBorderBrush}" />
        </Style>
        <!-- A slim card that opens the call setup while steps are left. -->
        <Style Selector="Button.banner">
            <Setter Property="Padding" Value="14,10,10,10" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
        </Style>
        <Style Selector="Button.banner /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <!-- Hints of a recording: the answer is a big card, the request a small chip on the right. -->
        <Style Selector="Border.answer">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.request">
            <Setter Property="Background" Value="{DynamicResource EchoUserBubbleBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.liveStatus">
            <Setter Property="Foreground" Value="{DynamicResource EchoSoftTextBrush}" />
        </Style>
        <Style Selector="TextBlock.liveStatus.problem">
            <Setter Property="Foreground" Value="#E09B1A" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootGrid">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- App bar: the logo and the calls status on Home and in Settings; in a session a back arrow, its name and «⋯». -->
            <Border Height="56"
                    Padding="4,0,8,0"
                    Background="{DynamicResource EchoHeaderBrush}"
                    BorderBrush="{DynamicResource EchoBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel x:Name="HomeLogo"
                                Orientation="Horizontal"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <controls:EchoLogo Width="30" Height="30" Margin="-2,0,6,0" IsAnimating="{Binding IsCapturing}" />
                        <TextBlock FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{DynamicResource EchoTextBrush}"><Run Text="Repl" /><Run Foreground="{DynamicResource EchoAccentTextBrush}" Text="io" /></TextBlock>
                    </StackPanel>
                    <Button x:Name="BackButton"
                            Classes="ghost icon"
                            IsVisible="False"
                            Click="Back_OnClick">
                        <Path Width="20"
                              Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource EchoTextBrush}"
                              StrokeThickness="2.4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="M 8,1 L 1,8 L 8,15 M 1,8 L 19,8" />
                    </Button>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   FontSize="18"
                                   FontWeight="ExtraBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource EchoTextBrush}" />
                        <TextBlock x:Name="PageSubtitleText"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource EchoMutedBrush}"
                                   IsVisible="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CallPill" Classes="callPill" Click="CallPill_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="CallPillDot" Width="9" Height="9" VerticalAlignment="Center" Fill="{DynamicResource EchoAccentBrush}" />
                                <TextBlock x:Name="CallPillText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource EchoTextBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SessionMenuButton"
                                Classes="ghost icon"
                                IsVisible="False"
                                Click="SessionPageMenu_OnClick">
                            <TextBlock FontSize="22" FontWeight="Bold" Text="⋯" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Panel Grid.Row="1">
                <!-- ===== Home: groups as chips, the call setup while it is not finished, a group's pages, the sessions. ===== -->
                <Grid x:Name="HomePage"
                      RowDefinitions="Auto,Auto,Auto,*,Auto"
                      IsVisible="{Binding SelectedMainPage, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Home}">
                    <!-- Groups: «Все сессии», «Без группы» and the user's groups. Press and hold a group for its actions. -->
                    <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ListBox x:Name="TopicChips"
                                     Margin="12,0,0,0"
                                     ItemsSource="{Binding TopicItems}"
                                     SelectedItem="{Binding SelectedTopicItem, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="topicChip longPress" Height="40" Padding="14,0" CornerRadius="20" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock MaxWidth="180"
                                                           FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource EchoTextBrush}"
                                                           Text="{Binding Name}" />
                                                <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource EchoAccentBrush}" IsVisible="{Binding IsStale}" />
                                                <TextBlock Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding SessionCount}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Classes="ghost icon"
                                Margin="2,0,6,0"
                                ToolTip.Tip="{Binding [NewGroup], Source={x:Static platform:MobileText.Instance}}"
                                Command="{Binding CreateTopicCommand}">
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource EchoTextBrush}" StrokeThickness="2.4" StrokeLineCap="Round" Data="M 9,1 L 9,17 M 1,9 L 17,9" />
                        </Button>
                    </Grid>

                    <!-- Calls are not set up yet: one slim card instead of the steps themselves. -->
                    <Button x:Name="CallSetupBanner"
                            Grid.Row="1"
                            Classes="banner"
                            Margin="12,8,12,0"
                            IsVisible="False"
                            Click="CallSetup_OnClick">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center" Background="{DynamicResource EchoAccentBrush}">
                                <Path Width="16" Height="18" Stretch="Uniform" Stroke="{DynamicResource EchoAccentInkBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M 3,1 L 7,1 L 9,6 L 6.5,7.5 C 7.5,10 9.5,12 12,13 L 13.5,10.5 L 18,12.5 L 18,16.5 C 18,17.5 17,18.5 16,18.5 C 8,18 2,12 1.5,4 C 1.5,2.5 2,1 3,1 Z" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CallSetupBannerTitle" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" />
                                <TextBlock x:Name="CallSetupBannerText" Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="8" Height="14" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource EchoSoftTextBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Data="M 1,1 L 7,7 L 1,13" />
                        </Grid>
                    </Button>

                    <!-- Pages of a group. -->
                    <Border Grid.Row="2"
                            Margin="0,4,0,0"
                            BorderBrush="{DynamicResource EchoBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding IsTopicSelected}">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <RadioButton GroupName="TopicTab" Classes="tab" IsChecked="{Binding IsTopicTabSessions, Mode=TwoWay}" Content="{Binding L[TopicTabSessions]}" />
                                <RadioButton GroupName="TopicTab" Classes="tab" IsChecked="{Binding IsTopicTabSummary, Mode=TwoWay}" Content="{Binding L[TopicTabSummary]}" />
                                <RadioButton GroupName="TopicTab" Classes="tab" IsChecked="{Binding IsTopicTabKnowledge, Mode=TwoWay}" Content="{Binding L[TopicTabKnowledge]}" />
                                <RadioButton GroupName="TopicTab" Classes="tab" IsChecked="{Binding IsTopicTabQuestions, Mode=TwoWay}" Content="{Binding L[TopicTabQuestions]}" />
                                <RadioButton GroupName="TopicTab" Classes="tab" IsChecked="{Binding IsTopicTabGraph, Mode=TwoWay}" Content="{Binding L[TopicTabGraph]}" />
                                <RadioButton GroupName="TopicTab" Classes="tab" IsChecked="{Binding IsTopicTabMeetings, Mode=TwoWay}" Content="{Binding L[TopicTabMeetings]}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Panel Grid.Row="3" Margin="12,8,12,0">
                        <!-- Sessions: search and «⋯» (select several, the group's actions), then the cards. A tap opens a
                             session, press and hold gives its actions. -->
                        <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowSessionsPanel}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Classes="search"
                                         Watermark="{Binding [SearchPlaceholder], Source={x:Static platform:MobileText.Instance}}"
                                         Text="{Binding SessionQuery}">
                                    <TextBox.InnerLeftContent>
                                        <Path Width="16" Height="16" Margin="12,0,2,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource EchoMutedBrush}" StrokeThickness="2" StrokeLineCap="Round"
                                              Data="M 7,1 C 10.3,1 13,3.7 13,7 C 13,10.3 10.3,13 7,13 C 3.7,13 1,10.3 1,7 C 1,3.7 3.7,1 7,1 Z M 11.5,11.5 L 16,16" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Classes="ghost icon"
                                        Margin="4,0,0,0"
                                        Click="ListMenu_OnClick">
                                    <TextBlock FontSize="22" FontWeight="Bold" Text="⋯" />
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding VisibleSessionsCount, Converter={x:Static controls:IsZeroConverter.Instance}}">
                                <StackPanel Margin="24,40,24,110" MaxWidth="340" HorizontalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Background="{DynamicResource EchoAccentSoftBrush}">
                                        <Path Width="22" Height="30" Stretch="Uniform" Stroke="{DynamicResource EchoAccentTextBrush}" StrokeThickness="2.2" StrokeLineCap="Round"
                                              Data="M 9,1 C 11,1 12,2.5 12,4 L 12,11 C 12,13 10.5,14 9,14 C 7.5,14 6,13 6,11 L 6,4 C 6,2.5 7,1 9,1 Z M 2,10 C 2,14.5 5,18 9,18 C 13,18 16,14.5 16,10 M 9,18 L 9,22 M 5.5,22.5 L 12.5,22.5" />
                                    </Border>
                                    <TextBlock x:Name="EmptyTitleText" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource EchoTextBrush}" />
                                    <TextBlock x:Name="EmptyText" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="14.5" LineHeight="21" Foreground="{DynamicResource EchoSoftTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                            <ListBox x:Name="SessionsList"
                                     Grid.Row="1"
                                     Margin="0,4,0,0"
                                     Padding="0,0,0,100"
                                     ItemsSource="{Binding CompletedSessionsView}"
                                     controls:ItemContainer.Classes="plain"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.DataTemplates>
                                    <DataTemplate DataType="vm:SessionGroupHeader">
                                        <TextBlock Margin="4,14,0,8" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding Name}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="models:SessionSummary">
                                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                                            <CheckBox Margin="2,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsVisible="{Binding $parent[UserControl].DataContext.IsSelectionMode}" />
                                            <Button Grid.Column="1"
                                                    Classes="sessionCard longPress"
                                                    Classes.checked="{Binding IsChecked}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="16,12"
                                                    Click="SessionCard_OnClick">
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource EchoTextBrush}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               LineHeight="22"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Title}" />
                                                    <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*">
                                                        <TextBlock VerticalAlignment="Center" FontSize="13.5" Foreground="{DynamicResource EchoMutedBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{x:Static views:SessionMetaConverter.Instance}">
                                                                    <Binding Path="StartedAt" />
                                                                    <Binding Path="Usage.SessionDurationMinutes" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Border Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                Padding="9,2"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="10"
                                                                BorderThickness="1"
                                                                Background="{DynamicResource EchoAccentSoftBrush}"
                                                                BorderBrush="{DynamicResource EchoAccentSoftBorderBrush}"
                                                                IsVisible="{Binding TopicName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EchoBadgeTextBrush}" Text="{Binding TopicName}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                        </Grid>

                        <!-- «Сводка». -->
                        <Border Classes="card" Margin="0,0,0,84" IsVisible="{Binding ShowSummaryPanel}">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBlock FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding L[KnowledgeSummaryTitle]}" />
                                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <controls:EchoThinkingDots Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsTopicBusy}" />
                                        <TextBlock Grid.Column="1" Classes="staleStatus" Classes.stale="{Binding IsTopicKnowledgeStale}" FontSize="14" TextWrapping="Wrap" Text="{Binding TopicKnowledgeStatusText}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                                        <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding RefreshTopicKnowledgeCommand}" Content="{Binding L[TopicRefreshKnowledge]}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" Command="{Binding CopyTopicKnowledgeCommand}" Content="{Binding L[CopyText]}" />
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid Margin="0,10,0,0">
                                        <controls:MarkdownDocumentView Markdown="{Binding TopicKnowledgeText}" IsVisible="{Binding HasTopicKnowledge}" />
                                        <TextBlock Margin="0,24,0,0"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource EchoMutedBrush}"
                                                   Text="{Binding L[KnowledgeSummaryEmpty]}"
                                                   IsVisible="{Binding !HasTopicKnowledge}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- «База знаний»: sources; a tap opens the parsed text over the page. -->
                        <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding ShowKnowledgePanel}">
                            <!-- Same four buttons as on the computer: documents and pictures, a folder, recordings, own text. -->
                            <UniformGrid Columns="2">
                                <Button Margin="0,0,3,3" Padding="4,0" HorizontalAlignment="Stretch" FontSize="15" Command="{Binding AddKnowledgeFilesCommand}" Content="{Binding L[KnowledgeAddFiles]}" />
                                <Button Margin="3,0,0,3" Padding="4,0" HorizontalAlignment="Stretch" FontSize="15" Command="{Binding AddKnowledgeFolderCommand}" Content="{Binding L[KnowledgeAddFolder]}" />
                                <Button Margin="0,3,3,0" Padding="4,0" HorizontalAlignment="Stretch" FontSize="15" Command="{Binding AddKnowledgeMediaCommand}" Content="{Binding L[KnowledgeAddMedia]}" />
                                <Button Margin="3,3,0,0" Padding="4,0" HorizontalAlignment="Stretch" FontSize="15" Click="AddNote_OnClick" Content="{Binding L[KnowledgeAddNote]}" />
                            </UniformGrid>
                            <Grid Grid.Row="1" Margin="2,10,0,4" ColumnDefinitions="*,Auto" IsVisible="{Binding HasKnowledgeSources}">
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding KnowledgeSourcesSummary}" IsVisible="{Binding !IsKnowledgeSelectionMode}" />
                                <Button Classes="ghost" Padding="8,0" Command="{Binding SelectAllKnowledgeCommand}" Content="{Binding L[SelectAllSessions]}" IsVisible="{Binding IsKnowledgeSelectionMode}" />
                                <Button Grid.Column="1" Classes="ghost" Padding="8,0" Command="{Binding ToggleKnowledgeSelectionModeCommand}" Content="{Binding L[SelectSessions]}" IsVisible="{Binding !IsKnowledgeSelectionMode}" />
                                <Button Grid.Column="1" Classes="ghost" Padding="8,0" Command="{Binding ToggleKnowledgeSelectionModeCommand}" Content="{Binding L[SelectDone]}" IsVisible="{Binding IsKnowledgeSelectionMode}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Margin="2,14,2,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding L[KnowledgeListHint]}" IsVisible="{Binding !HasKnowledgeSources}" />
                            <ListBox Grid.Row="2"
                                     x:Name="KnowledgeList"
                                     Padding="0,0,0,90"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding KnowledgeItems}"
                                     controls:ItemContainer.Classes="plain"
                                     IsVisible="{Binding HasKnowledgeSources}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                                            <CheckBox Margin="2,0,10,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsVisible="{Binding $parent[UserControl].DataContext.IsKnowledgeSelectionMode}" />
                                            <Button Grid.Column="1"
                                                    Classes="sessionCard"
                                                    Classes.checked="{Binding IsChecked}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="12,10"
                                                    Click="KnowledgeItem_OnClick">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="34" Height="34" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource EchoSurfaceAltBrush}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource EchoAccentTextBrush}" Text="{Binding KindGlyph}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding Title}" />
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <controls:EchoThinkingDots Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                                                            <TextBlock Classes="knowledgeStatus"
                                                                       Classes.fresh="{Binding State, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=New}"
                                                                       Classes.changed="{Binding State, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Changed}"
                                                                       Classes.failed="{Binding State, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Failed}"
                                                                       FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding StatusText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                <Button Classes="accent"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ParseAllKnowledgeCommand}"
                                        Content="{Binding L[KnowledgeParseAll]}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="HasUnparsedKnowledge" />
                                            <Binding Path="!IsKnowledgeSelectionMode" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                </Button>
                                <Button Classes="dangerSoft"
                                        HorizontalAlignment="Stretch"
                                        Click="RemoveCheckedKnowledge_OnClick"
                                        Content="{Binding RemoveCheckedKnowledgeText}"
                                        IsVisible="{Binding IsKnowledgeSelectionMode}" />
                            </StackPanel>
                        </Grid>

                        <!-- «Вопросы». -->
                        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowQuestionsPanel}">
                            <Border Classes="card" Padding="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox MinHeight="44"
                                             MaxHeight="140"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Watermark="{Binding L[TopicAskPlaceholder]}"
                                             Text="{Binding TopicQuestionText}" />
                                    <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding AskTopicCommand}" Content="{Binding L[TopicAsk]}" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="2,10,0,4" ColumnDefinitions="*,Auto" IsVisible="{Binding HasTopicQuestions}">
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding TopicQuestionsSummary}" IsVisible="{Binding !IsQuestionSelectionMode}" />
                                <Button Classes="ghost" Padding="8,0" Command="{Binding SelectAllQuestionsCommand}" Content="{Binding L[SelectAllSessions]}" IsVisible="{Binding IsQuestionSelectionMode}" />
                                <Button Grid.Column="1" Classes="ghost" Padding="8,0" Command="{Binding ToggleQuestionSelectionModeCommand}" Content="{Binding L[SelectSessions]}" IsVisible="{Binding !IsQuestionSelectionMode}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsQuestionSelectionMode}">
                                    <Button Classes="dangerSoft" Padding="10,0" Click="RemoveCheckedQuestions_OnClick" Content="{Binding RemoveCheckedQuestionsText}" />
                                    <Button Classes="accent" Margin="6,0,0,0" Padding="10,0" Command="{Binding ToggleQuestionSelectionModeCommand}" Content="{Binding L[SelectDone]}" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !HasTopicQuestions}">
                            <StackPanel Margin="0,22,0,96">
                                <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding L[QuestionsEmptyTitle]}" />
                                <TextBlock Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding L[QuestionsEmptyHint]}" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Classes="chip" Margin="4" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion1]}" Content="{Binding L[QuestionSuggestion1]}" />
                                    <Button Classes="chip" Margin="4" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion2]}" Content="{Binding L[QuestionSuggestion2]}" />
                                    <Button Classes="chip" Margin="4" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion3]}" Content="{Binding L[QuestionSuggestion3]}" />
                                    <Button Classes="chip" Margin="4" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion4]}" Content="{Binding L[QuestionSuggestion4]}" />
                                </WrapPanel>
                            </StackPanel>
                            </ScrollViewer>
                            <ListBox Grid.Row="2"
                                     Padding="0,0,0,90"
                                     ItemsSource="{Binding QuestionItems}"
                                     controls:ItemContainer.Classes="plain"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsVisible="{Binding HasTopicQuestions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                                            <CheckBox Margin="2,16,10,0"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsVisible="{Binding $parent[UserControl].DataContext.IsQuestionSelectionMode}" />
                                            <Border Grid.Column="1" Classes="questionCard" Classes.checked="{Binding IsChecked}">
                                                <StackPanel>
                                                    <Button Classes="questionHeader"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding $parent[UserControl].DataContext.ToggleQuestionCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="20,*">
                                                            <Path Classes="chevron"
                                                                  Classes.expanded="{Binding IsExpanded}"
                                                                  Width="7"
                                                                  Height="11"
                                                                  Margin="0,5,0,0"
                                                                  VerticalAlignment="Top"
                                                                  Stretch="Uniform"
                                                                  StrokeThickness="2"
                                                                  StrokeLineCap="Round"
                                                                  StrokeJoin="Round"
                                                                  Data="M 1,1 L 6,5.5 L 1,10"
                                                                  Stroke="{DynamicResource EchoAccentTextBrush}"
                                                                  RenderTransformOrigin="0.5,0.5" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding Question}" />
                                                                <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding MetaText}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <StackPanel Margin="32,0,12,12" IsVisible="{Binding IsExpanded}">
                                                        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsPending}">
                                                            <controls:EchoThinkingDots Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <TextBlock FontSize="13.5" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding $parent[UserControl].DataContext.L[TopicAskBusy]}" />
                                                        </StackPanel>
                                                        <controls:MarkdownView Markdown="{Binding Answer}" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding !IsPending}" />
                                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" IsVisible="{Binding !IsPending}">
                                                            <Button Classes="ghost"
                                                                    Padding="10,0"
                                                                    Command="{Binding $parent[UserControl].DataContext.CopyTopicAnswerCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{Binding $parent[UserControl].DataContext.L[CopyText]}" />
                                                            <Button Classes="ghost"
                                                                    Padding="10,0"
                                                                    Click="RemoveQuestion_OnClick"
                                                                    Content="{Binding $parent[UserControl].DataContext.L[DialogDelete]}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- «Как помогать»: the group's meeting type, hint guidance, summary format and names (MainViewModel.MeetingStyle.cs). -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowMeetingsPanel}">
                            <StackPanel Margin="0,0,0,96">
                                <Border Classes="card" Padding="14">
                                    <StackPanel DataContext="{Binding TopicMeetingStyle}">
                                        <TextBlock FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding $parent[UserControl].DataContext.L[MeetingStyleTitle]}" />
                                        <TextBlock Classes="hint" Text="{Binding $parent[UserControl].DataContext.L[MeetingStyleIntro]}" />
                                        <TextBlock Classes="label" Text="{Binding $parent[UserControl].DataContext.L[MeetingStylePresetLabel]}" />
                                        <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding Presets}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                                        <TextBlock Classes="hint" Text="{Binding InheritedText}" IsVisible="{Binding IsInherited}" />
                                        <StackPanel IsVisible="{Binding HasOwnTexts}">
                                            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding $parent[UserControl].DataContext.L[MeetingGuidanceLabel]}" />
                                            <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding $parent[UserControl].DataContext.L[MeetingGuidanceHint]}" />
                                            <TextBox MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Guidance, Mode=TwoWay}" />
                                            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding $parent[UserControl].DataContext.L[SummaryFormatLabel]}" />
                                            <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding $parent[UserControl].DataContext.L[SummaryFormatHint]}" />
                                            <TextBox MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding SummaryFormat, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel DataContext="{Binding $parent[UserControl].DataContext}">
                                            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding L[TopicGlossaryLabel]}" />
                                            <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding L[TopicGlossaryHint]}" />
                                            <TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="{Binding L[TopicGlossaryExample]}" Text="{Binding TopicSttGlossary, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- «Граф». -->
                        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowGraphPanel}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:EchoThinkingDots Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsGraphBusy}" />
                                    <TextBlock Classes="staleStatus" Classes.stale="{Binding IsGraphStale}" FontSize="13" MaxWidth="200" TextWrapping="Wrap" Text="{Binding GraphStatusText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="accent" Padding="14,0" Command="{Binding BuildTopicGraphCommand}" Content="{Binding BuildGraphButtonText}" />
                            </Grid>
                            <TextBox x:Name="GraphSearchTextBox" Grid.Row="1" Margin="0,10,0,0" Watermark="{Binding L[GraphSearchPlaceholder]}" IsVisible="{Binding HasGraph}" />
                            <Border Grid.Row="2"
                                    Margin="0,10,0,84"
                                    CornerRadius="16"
                                    ClipToBounds="True"
                                    Background="{DynamicResource EchoSurfaceBrush}"
                                    BorderBrush="{DynamicResource EchoBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <controls:GraphView x:Name="TopicGraphView" Graph="{Binding CurrentGraph}" Filter="{Binding #GraphSearchTextBox.Text}" />
                                    <!-- A touch screen has no wheel: zoom with buttons; a double tap fits the whole graph. -->
                                    <StackPanel Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8" IsVisible="{Binding HasGraph}">
                                        <Button x:Name="GraphZoomInButton" Classes="icon graphZoom" FontSize="22" Click="GraphZoomIn_OnClick" Content="+" />
                                        <Button Classes="icon graphZoom" FontSize="22" Click="GraphZoomOut_OnClick" Content="−" />
                                        <Button Classes="icon graphZoom" Click="GraphFit_OnClick">
                                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round"
                                                  Data="M 1,6 L 1,1 L 6,1 M 12,1 L 17,1 L 17,6 M 17,12 L 17,17 L 12,17 M 6,17 L 1,17 L 1,12" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Margin="20" VerticalAlignment="Center" IsVisible="{Binding !HasGraph}">
                                        <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding L[GraphEmptyTitle]}" />
                                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding L[GraphEmptyHint]}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Panel>

                    <!-- Bulk actions while selecting sessions. -->
                    <Border Grid.Row="4"
                            Padding="12,10"
                            Background="{DynamicResource EchoHeaderBrush}"
                            BorderBrush="{DynamicResource EchoBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ShowSessionsPanel" />
                                <Binding Path="IsSelectionMode" />
                            </MultiBinding>
                        </Border.IsVisible>
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Classes="ghost" Padding="10,0" Command="{Binding SelectAllSessionsCommand}" Content="{Binding L[SelectAllSessions]}" />
                                <Button Grid.Column="2" Classes="accent" Padding="18,0" Command="{Binding ToggleSelectionModeCommand}" Content="{Binding L[SelectDone]}" />
                            </Grid>
                            <UniformGrid Columns="2">
                                <Button Margin="0,0,4,0" HorizontalAlignment="Stretch" IsEnabled="{Binding HasCheckedSessions}" Click="MoveChecked_OnClick" Content="{Binding [Move], Source={x:Static platform:MobileText.Instance}}" />
                                <Button Classes="dangerSoft" Margin="4,0,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding HasCheckedSessions}" Click="DeleteChecked_OnClick" Content="{Binding DeleteCheckedText}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== A session. While recording: a big timer with «Стоп», one plain status line, «Подсказки» | «Текст»
                     and the hint buttons under the thumb. Afterwards: «Итоги», «Текст», «Подсказки», «Письмо». ===== -->
                <Grid x:Name="SessionPage"
                      RowDefinitions="Auto,Auto,*,Auto"
                      IsVisible="{Binding SelectedMainPage, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Session}">
                    <Border x:Name="LiveCard"
                            Margin="12,10,12,0"
                            Padding="16,10,10,12"
                            CornerRadius="20"
                            BorderThickness="1"
                            Background="{DynamicResource EchoSurfaceBrush}"
                            BorderBrush="{DynamicResource EchoBorderBrush}"
                            IsVisible="False">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="LiveDot" Width="12" Height="12" VerticalAlignment="Center" Fill="#E5484D" />
                                <TextBlock x:Name="LiveTimerText"
                                           Margin="10,0,12,0"
                                           VerticalAlignment="Center"
                                           FontSize="30"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource EchoTextBrush}"
                                           Text="00:00" />
                                <controls:EchoListeningBars VerticalAlignment="Center" IsActive="{Binding IsCapturing}" />
                            </StackPanel>
                            <Button x:Name="StopButton"
                                    Grid.Column="1"
                                    Classes="dangerSoft"
                                    MinHeight="48"
                                    Padding="18,0"
                                    CornerRadius="24"
                                    VerticalAlignment="Center"
                                    Click="StopRecording_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="13" Height="13" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource EchoDangerTextBrush}" />
                                    <TextBlock x:Name="StopButtonText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="{Binding [StopShort], Source={x:Static platform:MobileText.Instance}}" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="LiveStatusText"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,6,0,0"
                                       Classes="liveStatus"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       LineHeight="21"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- While recording: two halves. -->
                    <Border x:Name="LiveTabs"
                            Grid.Row="1"
                            Margin="12,10,12,0"
                            Padding="3"
                            CornerRadius="25"
                            Background="{DynamicResource EchoSurfaceAltBrush}"
                            IsVisible="False">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="TabLiveAssist" GroupName="LiveTab" Classes="segment" Tag="Assist" Click="SessionTab_OnClick" Content="{Binding [TabAssist], Source={x:Static platform:MobileText.Instance}}" />
                            <RadioButton x:Name="TabLiveTranscript" GroupName="LiveTab" Classes="segment" Tag="Transcript" Click="SessionTab_OnClick" Content="{Binding [TabText], Source={x:Static platform:MobileText.Instance}}" />
                        </UniformGrid>
                    </Border>
                    <!-- A finished session: its pages. -->
                    <Border x:Name="SessionTabs"
                            Grid.Row="1"
                            BorderBrush="{DynamicResource EchoBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <RadioButton x:Name="TabSummary" GroupName="SessionTab" Classes="tab" Tag="Summary" Click="SessionTab_OnClick" Content="{Binding L[TabSummary]}" />
                                <RadioButton x:Name="TabTranscript" GroupName="SessionTab" Classes="tab" Tag="Transcript" Click="SessionTab_OnClick" Content="{Binding [TabText], Source={x:Static platform:MobileText.Instance}}" />
                                <RadioButton x:Name="TabAssist" GroupName="SessionTab" Classes="tab" Tag="Assist" Click="SessionTab_OnClick" Content="{Binding [TabAssist], Source={x:Static platform:MobileText.Instance}}" />
                                <RadioButton x:Name="TabEmail" GroupName="SessionTab" Classes="tab" Tag="Email" Click="SessionTab_OnClick" Content="{Binding L[TabEmail]}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Panel Grid.Row="2" Margin="12,10,12,0">
                        <!-- Hints: each answer a big card; press and hold to copy or share it. -->
                        <ListBox x:Name="AssistList"
                                 IsVisible="False"
                                 Padding="0,0,0,8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 controls:ItemContainer.Classes="plain"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="views:PhoneChatItem">
                                    <Panel Classes="chatItem">
                                        <Panel.RenderTransform>
                                            <TranslateTransform />
                                        </Panel.RenderTransform>
                                        <Border Classes="request" Margin="48,2,0,8" IsVisible="{Binding IsUser}">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding Message}" />
                                        </Border>
                                        <Border Classes="answer longPress" Margin="0,0,0,12" IsVisible="{Binding IsAnswer}">
                                            <TextBlock FontSize="18" LineHeight="26" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding Message}" />
                                        </Border>
                                        <StackPanel Margin="6,4,0,12" Orientation="Horizontal" IsVisible="{Binding IsThinking}">
                                            <controls:EchoThinkingDots VerticalAlignment="Center" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding [Thinking], Source={x:Static platform:MobileText.Instance}}" />
                                        </StackPanel>
                                        <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="14" Background="{DynamicResource EchoSurfaceAltBrush}" IsVisible="{Binding IsNotice}">
                                            <TextBlock FontSize="14.5" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding Message}" />
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="AssistEmpty" Margin="24,0,24,40" MaxWidth="320" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False">
                            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Background="{DynamicResource EchoAccentSoftBrush}">
                                <Path Width="26" Height="24" Stretch="Uniform" Stroke="{DynamicResource EchoAccentTextBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M 3,1 L 21,1 C 22,1 23,2 23,3 L 23,15 C 23,16 22,17 21,17 L 10,17 L 5,22 L 5,17 L 3,17 C 2,17 1,16 1,15 L 1,3 C 1,2 2,1 3,1 Z M 6,7 L 18,7 M 6,11 L 14,11" />
                            </Border>
                            <TextBlock x:Name="AssistEmptyText" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="15.5" LineHeight="22" Foreground="{DynamicResource EchoSoftTextBrush}" />
                        </StackPanel>

                        <Grid x:Name="SummaryPanel" RowDefinitions="Auto,*" IsVisible="False">
                            <UniformGrid Columns="3">
                                <Button Classes="accent secondary" Margin="0,0,3,0" Command="{Binding CopySummaryCommand}" Content="{Binding L[CopyText]}" />
                                <Button Classes="secondary" Margin="3,0" Click="ShareSummary_OnClick" Content="{Binding [Share], Source={x:Static platform:MobileText.Instance}}" />
                                <Button Classes="secondary" Margin="3,0,0,0" Command="{Binding RegenerateSummaryCommand}" Content="{Binding [Redo], Source={x:Static platform:MobileText.Instance}}" />
                            </UniformGrid>
                            <Border Grid.Row="1" Margin="0,10,0,12" VerticalAlignment="Top" Classes="card">
                                <controls:MarkdownView Markdown="{Binding CurrentSessionSummary}" />
                            </Border>
                        </Grid>

                        <Grid x:Name="TranscriptPanel" RowDefinitions="Auto,*" IsVisible="False">
                            <Button x:Name="CopyTranscriptButton" Classes="secondary" HorizontalAlignment="Right" Padding="16,0" Command="{Binding CopyTranscriptCommand}" Content="{Binding L[CopyText]}" />
                            <ListBox x:Name="TranscriptList"
                                     Grid.Row="1"
                                     Margin="0,8,0,0"
                                     Padding="0,0,0,12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     controls:ItemContainer.Classes="plain"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding SelectedSessionTranscript}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="longPress" Padding="2,0,2,14" Background="Transparent">
                                            <TextBlock FontSize="16" LineHeight="23" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding Text}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid x:Name="EmailPanel" RowDefinitions="Auto,Auto,*" IsVisible="False">
                            <UniformGrid Columns="3">
                                <Button Classes="accent secondary" Margin="0,0,3,0" Command="{Binding CopyFollowUpEmailCommand}" Content="{Binding L[CopyText]}" />
                                <Button Classes="secondary" Margin="3,0" Click="ShareEmail_OnClick" IsEnabled="{Binding HasFollowUpEmail}" Content="{Binding [Share], Source={x:Static platform:MobileText.Instance}}" />
                                <Button Classes="secondary" Margin="3,0,0,0" Command="{Binding FollowUpEmailCommand}" Content="{Binding [Redo], Source={x:Static platform:MobileText.Instance}}" />
                            </UniformGrid>
                            <StackPanel Grid.Row="1" Margin="2,10,0,0" Orientation="Horizontal">
                                <controls:EchoThinkingDots Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding IsFollowUpEmailBusy}" />
                                <Panel>
                                    <TextBlock MaxWidth="320" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding L[FollowUpEmailBusy]}" IsVisible="{Binding IsFollowUpEmailBusy}" />
                                    <TextBlock MaxWidth="320" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding L[FollowUpEmailHint]}">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!HasFollowUpEmail" />
                                                <Binding Path="!IsFollowUpEmailBusy" />
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                </Panel>
                            </StackPanel>
                            <TextBox Grid.Row="2"
                                     Margin="0,10,0,12"
                                     Classes="readOnlyText"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Text="{Binding CurrentFollowUpEmail, Mode=OneWay}" />
                        </Grid>
                    </Panel>

                    <!-- Hint buttons under the thumb: one big «Что сказать», three small ones, a question on demand. -->
                    <Border x:Name="AskBar"
                            Grid.Row="3"
                            Padding="12,10,12,12"
                            Background="{DynamicResource EchoHeaderBrush}"
                            BorderBrush="{DynamicResource EchoBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">
                            <Grid x:Name="AskRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                <TextBox x:Name="AskTextBox"
                                         MaxHeight="120"
                                         AcceptsReturn="False"
                                         TextWrapping="Wrap"
                                         Watermark="{Binding [AskPlaceholder], Source={x:Static platform:MobileText.Instance}}" />
                                <Button Grid.Column="1"
                                        Classes="accent icon"
                                        Margin="8,0,0,0"
                                        CornerRadius="24"
                                        VerticalAlignment="Bottom"
                                        ToolTip.Tip="{Binding [AskSend], Source={x:Static platform:MobileText.Instance}}"
                                        Click="Ask_OnClick">
                                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Data="M 9,17 L 9,1 M 2,8 L 9,1 L 16,8" />
                                </Button>
                            </Grid>
                            <Button x:Name="WhatToSayButton"
                                    Classes="accent"
                                    Tag="Reply"
                                    MinHeight="56"
                                    CornerRadius="28"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Click="QuickAction_OnClick"
                                    Content="{Binding [ActWhatToSay], Source={x:Static platform:MobileText.Instance}}" />
                            <UniformGrid Columns="3">
                                <Button x:Name="WhatToAskButton" Classes="secondary" Margin="0,0,4,0" Tag="Next" Click="QuickAction_OnClick" Content="{Binding [ActWhatToAsk], Source={x:Static platform:MobileText.Instance}}" />
                                <Button x:Name="RecapButton" Classes="secondary" Margin="2,0" Tag="Recap" Click="QuickAction_OnClick" Content="{Binding [ActRecap], Source={x:Static platform:MobileText.Instance}}" />
                                <Button x:Name="AskToggleButton" Classes="secondary" Margin="4,0,0,0" Click="AskToggle_OnClick" Content="{Binding [ActAsk], Source={x:Static platform:MobileText.Instance}}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Settings: the computer's sections (MainViewModel.SettingsLayout.cs) as pills on top; each plan sees
                     only what it can use; changes are saved by themselves. No hotkeys, windows or data folder on a phone. ===== -->
                <Grid x:Name="SettingsPage"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding SelectedMainPage, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Settings}">
                    <Border BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <RadioButton GroupName="SettingsNav" Classes="tab" IsChecked="{Binding IsSettingsAccount, Mode=TwoWay}" Content="{Binding L[SettingsNav_account]}" />
                            <RadioButton GroupName="SettingsNav" Classes="tab" IsChecked="{Binding IsSettingsMeetings, Mode=TwoWay}" Content="{Binding L[SettingsNav_meetings]}" />
                            <RadioButton GroupName="SettingsNav" Classes="tab" IsChecked="{Binding IsSettingsSpeech, Mode=TwoWay}" Content="{Binding L[SettingsNav_speech]}" />
                            <RadioButton GroupName="SettingsNav" Classes="tab" IsChecked="{Binding IsSettingsAi, Mode=TwoWay}" Content="{Binding L[SettingsNav_ai]}" />
                            <RadioButton GroupName="SettingsNav" Classes="tab" IsChecked="{Binding IsSettingsWindows, Mode=TwoWay}" Content="{Binding [SettingsNavLook], Source={x:Static platform:MobileText.Instance}}" />
                            <RadioButton GroupName="SettingsNav" Classes="tab" IsChecked="{Binding IsSettingsData, Mode=TwoWay}" Content="{Binding [SettingsNavAbout], Source={x:Static platform:MobileText.Instance}}" />
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0,12,28">
                            <TextBlock Margin="4,10,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding SettingsSaveStatus}" />

                            <!-- ===== Аккаунт ===== -->
                            <StackPanel IsVisible="{Binding IsSettingsAccount}">
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding AccountPlanTitle}" IsVisible="{Binding IsSignedIn}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding AccountPlanDetails}" IsVisible="{Binding IsSignedIn}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding AccountStatusText}" />
                                        <StackPanel Margin="0,12,0,0" Spacing="8" IsVisible="{Binding IsSignedOut}">
                                            <Button Classes="accent" Height="48" HorizontalAlignment="Stretch" Command="{Binding SignInCommand}" Content="{Binding L[AccountSignIn]}" />
                                            <Button Height="44" HorizontalAlignment="Stretch" Command="{Binding OpenCabinetCommand}" Content="{Binding L[AccountOpenCabinet]}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0" Spacing="8" IsVisible="{Binding IsSigningIn}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:EchoThinkingDots Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <Border Padding="12,6" CornerRadius="8" Background="{DynamicResource EchoSurfaceAltBrush}" BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding SignInCode}" />
                                                </Border>
                                            </StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Margin="0,0,4,0" Height="44" HorizontalAlignment="Stretch" Command="{Binding OpenSignInPageCommand}" Content="{Binding L[AccountOpenPage]}" />
                                                <Button Margin="4,0,0,0" Height="44" HorizontalAlignment="Stretch" Command="{Binding CancelSignInCommand}" Content="{Binding L[AccountCancel]}" />
                                            </UniformGrid>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0" Spacing="8" IsVisible="{Binding IsSignedIn}">
                                            <Button Classes="accent" Height="48" HorizontalAlignment="Stretch" Command="{Binding OpenCabinetCommand}" Content="{Binding L[AccountOpenCabinet]}" />
                                            <Button Height="44" HorizontalAlignment="Stretch" Command="{Binding OpenUpgradeCommand}" Content="{Binding L[AccountUpgrade]}" />
                                            <UniformGrid Columns="2">
                                                <Button Margin="0,0,4,0" Height="44" HorizontalAlignment="Stretch" Command="{Binding RefreshAccountCommand}" Content="{Binding L[AccountRefresh]}" />
                                                <Button Margin="4,0,0,0" Height="44" HorizontalAlignment="Stretch" Command="{Binding SignOutCommand}" Content="{Binding L[AccountSignOut]}" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Встречи (по умолчанию): every group without its own «Как помогать». ===== -->
                            <StackPanel IsVisible="{Binding IsSettingsMeetings}">
                                <Border Classes="settingsCard">
                                    <StackPanel DataContext="{Binding DefaultMeetingStyle}">
                                        <TextBlock Classes="section" Text="{Binding $parent[UserControl].DataContext.L[SettingsSectionMeetings]}" />
                                        <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding $parent[UserControl].DataContext.L[SettingsMeetingsHint]}" />
                                        <TextBlock Classes="label" Text="{Binding $parent[UserControl].DataContext.L[MeetingStylePresetLabel]}" />
                                        <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding Presets}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                                        <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding $parent[UserControl].DataContext.L[MeetingGuidanceLabel]}" />
                                        <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding $parent[UserControl].DataContext.L[MeetingGuidanceHint]}" />
                                        <TextBox MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Guidance, Mode=TwoWay}" />
                                        <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding $parent[UserControl].DataContext.L[SummaryFormatLabel]}" />
                                        <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding $parent[UserControl].DataContext.L[SummaryFormatHint]}" />
                                        <TextBox MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding SummaryFormat, Mode=TwoWay}" />
                                        <StackPanel DataContext="{Binding $parent[UserControl].DataContext}">
                                            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding L[SettingsSttGlossary]}" />
                                            <TextBlock Classes="hint" Margin="0,0,0,6" Text="{Binding L[SettingsSttGlossaryHint]}" />
                                            <TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="{Binding L[SettingsSttGlossaryExample]}" Text="{Binding SttGlossary}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Речь ===== -->
                            <StackPanel IsVisible="{Binding IsSettingsSpeech}">
                                <!-- Recording check: a few seconds from the microphone recognized like in a recording. -->
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding [TestMicTitle], Source={x:Static platform:MobileText.Instance}}" />
                                        <TextBlock Classes="hint" Margin="0,0,0,8" Text="{Binding [TestMicHint], Source={x:Static platform:MobileText.Instance}}" />
                                        <Button x:Name="MicTestButton" Classes="accent" Height="52" HorizontalAlignment="Stretch" FontSize="16" Click="MicTest_OnClick"
                                                Content="{Binding [TestMicButton], Source={x:Static platform:MobileText.Instance}}" />
                                        <ProgressBar x:Name="MicTestLevel" Margin="0,10,0,0" Height="8" CornerRadius="4" Minimum="0" Maximum="1" IsVisible="False" />
                                        <TextBlock x:Name="MicTestResult" Margin="0,10,0,0" FontSize="14.5" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" IsVisible="False" />
                                        <TextBlock x:Name="SttHintText" Classes="hint" IsVisible="False" />
                                    </StackPanel>
                                </Border>
                                <!-- Бесплатный, Старт: in the Replio cloud, nothing to choose. -->
                                <Border Classes="settingsCard" IsVisible="{Binding ShowSttCloudInfo}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SttWhereTitle]}" />
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding SttCloudInfoTitle}" />
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding L[SttCloudPrivacy]}" />
                                        <TextBlock Classes="hint" Text="{Binding SttCloudInfoHint}" />
                                    </StackPanel>
                                </Border>
                                <!-- Про, Команда: Стандарт or Точная. -->
                                <Border Classes="settingsCard" IsVisible="{Binding ShowSttQualityChoice}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SttQualityTitle]}" />
                                        <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding ReplioSttModels}" SelectedItem="{Binding SelectedReplioSttModel, Mode=TwoWay}" />
                                        <TextBlock Classes="hint" Text="{Binding L[SttQualityHint]}" />
                                    </StackPanel>
                                </Border>
                                <!-- Локальный: only on this device. -->
                                <Border Classes="settingsCard" IsVisible="{Binding IsLocalSpeechPlan}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SttWhereTitle]}" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding [SttLocalPhoneTitle], Source={x:Static platform:MobileText.Instance}}" />
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding [SttLocalPhoneText], Source={x:Static platform:MobileText.Instance}}" />
                                    </StackPanel>
                                </Border>
                                <!-- Приватный: the company's own server. -->
                                <Border Classes="settingsCard" IsVisible="{Binding IsCompanyPlan}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding L[CompanyServiceTitle]}" />
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding CompanyServiceText}" />
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding CompanySpeechText}" />
                                    </StackPanel>
                                </Border>
                                <!-- Developer mode: on the phone or through an own service. -->
                                <Border Classes="settingsCard" IsVisible="{Binding ShowSttWhereChoice}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SttWhereChoiceTitle]}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="SttWhere" Classes="pill" IsChecked="{Binding IsSttOnComputer, Mode=TwoWay}" Content="{Binding [SttOnPhone], Source={x:Static platform:MobileText.Instance}}" />
                                            <RadioButton GroupName="SttWhere" Classes="pill" IsChecked="{Binding IsSttOwnService, Mode=TwoWay}" Content="{Binding L[SttOwnService]}" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowSttServiceSettings}">
                                            <TextBlock Classes="label" Text="{Binding L[SettingsProviderPreset]}" />
                                            <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding SttApiPresets}" SelectedItem="{Binding SelectedSttPreset, Mode=TwoWay}" />
                                            <StackPanel IsVisible="{Binding SttBaseUrlFieldVisibility}">
                                                <TextBlock Classes="label" Text="{Binding L[SettingsBaseUrl]}" />
                                                <TextBox Text="{Binding SttApiBaseUrl}" />
                                            </StackPanel>
                                            <TextBlock Classes="label" Text="{Binding L[SettingsSttApiKey]}" />
                                            <TextBox PasswordChar="•" Text="{Binding SttApiKey}" />
                                            <TextBlock Classes="hint" Text="{Binding SttKeySourceText}" />
                                            <TextBlock Classes="label" Text="{Binding L[SettingsSttModel]}" />
                                            <controls:ModelPicker Text="{Binding SttApiModel, Mode=TwoWay}" Options="{Binding SpeechModelOptions}" Status="{Binding SpeechModelsStatus}" LoadCommand="{Binding LoadSpeechModelsCommand}" />
                                            <TextBlock Classes="hint" Text="{Binding L[SttOwnServiceHint]}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- whisper.cpp models for recognition on the phone, downloaded once. -->
                                <Border x:Name="SpeechModelsSection" Classes="settingsCard" IsVisible="{Binding ShowSpeechModels}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SpeechModelTitle]}" />
                                        <TextBlock Classes="hint" Margin="0,0,0,0" Text="{Binding [PhoneSpeechIntro], Source={x:Static platform:MobileText.Instance}}" />
                                        <TextBlock x:Name="PhoneHardwareText" Classes="hint" />
                                        <TextBlock Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding SpeechModelStatusText}" IsVisible="{Binding IsSpeechModelMissing}" />
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SpeechModels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10" Classes="card" Padding="14,12">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding Title}" />
                                                                    <TextBlock Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding SizeText}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource EchoAccentTextBrush}" Text="{Binding StatusText}" />
                                                            </Grid>
                                                            <Border Margin="0,6,0,0" Padding="8,1" HorizontalAlignment="Left" CornerRadius="9" Background="{DynamicResource EchoAccentSoftBrush}" IsVisible="{Binding RecommendedVisibility}">
                                                                <TextBlock FontSize="11.5" Foreground="{DynamicResource EchoBadgeTextBrush}" Text="{Binding $parent[UserControl].DataContext.L[SpeechModelRecommended]}" />
                                                            </Border>
                                                            <TextBlock Margin="0,6,0,0" FontSize="13.5" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding Info.PhoneDescription}" />
                                                            <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding Info.PhoneSuitability}" />
                                                            <ProgressBar Margin="0,8,0,0" Height="6" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" IsVisible="{Binding DownloadingVisibility}" />
                                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                                <Button Classes="accent" Padding="16,0" IsVisible="{Binding DownloadVisibility}" Command="{Binding $parent[UserControl].DataContext.DownloadSpeechModelCommand}" CommandParameter="{Binding}" Content="{Binding $parent[UserControl].DataContext.L[SpeechModelDownload]}" />
                                                                <Button Padding="16,0" IsVisible="{Binding UseVisibility}" Command="{Binding $parent[UserControl].DataContext.UseSpeechModelCommand}" CommandParameter="{Binding}" Content="{Binding $parent[UserControl].DataContext.L[SpeechModelUse]}" />
                                                                <Button Classes="dangerSoft" Margin="8,0,0,0" Padding="16,0" IsVisible="{Binding DeleteVisibility}" Tag="{Binding}" Click="DeleteSpeechModel_OnClick" Content="{Binding $parent[UserControl].DataContext.L[SpeechModelDelete]}" />
                                                                <Button Padding="16,0" IsVisible="{Binding DownloadingVisibility}" Command="{Binding $parent[UserControl].DataContext.CancelSpeechModelDownloadCommand}" Content="{Binding $parent[UserControl].DataContext.L[SpeechModelCancel]}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SettingsSpeechLanguage]}" />
                                        <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding SpeechLanguageOptions}" SelectedItem="{Binding SelectedSpeechLanguage, Mode=TwoWay}" />
                                        <TextBlock Classes="hint" Text="{Binding L[TipSpeechLanguage]}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Replio-помощник ===== -->
                            <StackPanel IsVisible="{Binding IsSettingsAi}">
                                <Border Classes="settingsCard" IsVisible="{Binding IsManagedAi}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[AiModelsTitle]}" />
                                        <StackPanel IsVisible="{Binding ShowReplioModelNames}">
                                            <TextBlock Classes="label" Text="{Binding L[AiHintsModelLabel]}" />
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding ReplioFastModelName}" />
                                            <TextBlock Classes="label" Text="{Binding L[AiAnalysisModelLabel]}" />
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding ReplioAnalysisModelName}" />
                                            <TextBlock Classes="hint" Text="{Binding AiModelsHint}" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowReplioModelChoice}">
                                            <TextBlock Classes="label" Text="{Binding L[AiHintsModelLabel]}" />
                                            <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding ReplioFastModels}" SelectedItem="{Binding SelectedReplioFastModel, Mode=TwoWay}" />
                                            <TextBlock Classes="label" Text="{Binding L[AiAnalysisModelLabel]}" />
                                            <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding ReplioAnalysisModels}" SelectedItem="{Binding SelectedReplioAnalysisModel, Mode=TwoWay}" />
                                            <TextBlock Classes="hint" Text="{Binding L[TipReplioFastModel]}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settingsCard" IsVisible="{Binding IsCompanyPlan}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding L[CompanyServiceTitle]}" />
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" Text="{Binding CompanyServiceText}" />
                                    </StackPanel>
                                </Border>
                                <!-- Developer mode: own AI service. -->
                                <Border Classes="settingsCard" IsVisible="{Binding ShowOwnProviderSettings}">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[AiServiceTitle]}" />
                                        <TextBlock Classes="label" Text="{Binding L[SettingsProviderPreset]}" />
                                        <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding ApiProviderPresets}" SelectedItem="{Binding SelectedApiPreset, Mode=TwoWay}" />
                                        <StackPanel IsVisible="{Binding BaseUrlFieldVisibility}">
                                            <TextBlock Classes="label" Text="{Binding L[SettingsBaseUrl]}" />
                                            <TextBox Text="{Binding OpenAiBaseUrl}" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ApiKeyFieldVisibility}">
                                            <TextBlock Classes="label" Text="{Binding L[SettingsApiKey]}" />
                                            <TextBox PasswordChar="•" Text="{Binding OpenAiApiKey}" />
                                        </StackPanel>
                                        <TextBlock Classes="label" Text="{Binding L[SettingsModel]}" />
                                        <controls:ModelPicker Text="{Binding OpenAiModel, Mode=TwoWay}" Options="{Binding ChatModelOptions}" Status="{Binding ChatModelsStatus}" LoadCommand="{Binding LoadChatModelsCommand}" />
                                        <TextBlock Classes="label" Text="{Binding L[SettingsAnalysisModel]}" />
                                        <controls:ModelPicker Text="{Binding AnalysisModel, Mode=TwoWay}" Options="{Binding ChatModelOptions}" Status="{Binding ChatModelsStatus}" LoadCommand="{Binding LoadChatModelsCommand}" />
                                        <TextBlock Classes="hint" Text="{Binding L[SettingsModelPickerHint]}" />
                                        <StackPanel IsVisible="{Binding EndpointPathFieldVisibility}">
                                            <StackPanel IsVisible="{Binding ProviderFieldVisibility}">
                                                <TextBlock Classes="label" Text="{Binding L[SettingsProvider]}" />
                                                <TextBox Text="{Binding ApiProvider}" />
                                            </StackPanel>
                                            <TextBlock Classes="label" Text="{Binding L[SettingsEndpointPath]}" />
                                            <TextBox Text="{Binding ChatCompletionsPath}" />
                                            <StackPanel IsVisible="{Binding ApiKeyHeaderFieldVisibility}">
                                                <TextBlock Classes="label" Text="{Binding L[SettingsKeyHeader]}" />
                                                <TextBox Text="{Binding ApiKeyHeaderName}" />
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding ApiKeyPrefixFieldVisibility}">
                                                <TextBlock Classes="label" Text="{Binding L[SettingsKeyPrefix]}" />
                                                <TextBox Text="{Binding ApiKeyPrefix}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[ScreenContextTitle]}" />
                                        <CheckBox IsChecked="{Binding CaptureScreenContextEnabled, Mode=TwoWay}">
                                            <TextBlock TextWrapping="Wrap" Text="{Binding [PhoneScreenContext], Source={x:Static platform:MobileText.Instance}}" />
                                        </CheckBox>
                                        <TextBlock Classes="hint" Text="{Binding [PhoneScreenContextHint], Source={x:Static platform:MobileText.Instance}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Вид ===== -->
                            <StackPanel IsVisible="{Binding IsSettingsWindows}">
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[SettingsSectionAppearance]}" />
                                        <TextBlock Classes="label" Text="{Binding L[SettingsTheme]}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="ThemeMode" Classes="pill" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Content="{Binding L[ThemeDark]}" />
                                            <RadioButton GroupName="ThemeMode" Classes="pill" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" Content="{Binding L[ThemeLight]}" />
                                        </StackPanel>
                                        <TextBlock Classes="label" Text="{Binding L[SettingsLanguage]}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="UiLanguage" Classes="pill" IsChecked="{Binding IsRussianUi, Mode=TwoWay}" Content="Русский (RU)" />
                                            <RadioButton GroupName="UiLanguage" Classes="pill" IsChecked="{Binding IsEnglishUi, Mode=TwoWay}" Content="English (EN)" />
                                        </StackPanel>
                                        <TextBlock Classes="hint" Text="{Binding L[SettingsLanguageHint]}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== О приложении ===== -->
                            <StackPanel IsVisible="{Binding IsSettingsData}">
                                <!-- «Папка данных»: the same meetings and groups as on the computer, through a folder that a sync
                                     app keeps equal to the computer's cloud folder (MainView.DataFolder.cs). -->
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="{Binding L[DataFolderTitle]}" />
                                        <TextBlock Classes="hint" Margin="0" Text="{Binding [PhoneDataHint], Source={x:Static platform:MobileText.Instance}}" />
                                        <TextBlock Margin="0,12,0,2" FontSize="13" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding [PhoneDataNow], Source={x:Static platform:MobileText.Instance}}" />
                                        <TextBlock FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding DataFolderPath}" IsVisible="{Binding IsDataFolderCustom}" />
                                        <TextBlock FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding [PhoneDataDefault], Source={x:Static platform:MobileText.Instance}}" IsVisible="{Binding !IsDataFolderCustom}" />
                                        <Button Margin="0,14,0,0" Classes="accent" HorizontalAlignment="Stretch" Click="ChooseDataFolder_OnClick" IsEnabled="{Binding !IsDataFolderBusy}" Content="{Binding L[DataFolderChoose]}" />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="DataFolderHowTo_OnClick" Content="{Binding [PhoneDataHow], Source={x:Static platform:MobileText.Instance}}" />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding ResetDataFolderCommand}" IsVisible="{Binding IsDataFolderCustom}" Content="{Binding L[DataFolderReset]}" />
                                        <TextBlock Classes="hint" Margin="0,10,0,0" Text="{Binding DataFolderStatus}" IsVisible="{Binding DataFolderStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <Button Margin="0,10,0,0" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding RestartAppCommand}" IsVisible="{Binding IsRestartNeeded}" Content="{Binding L[DataFolderRestart]}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="settingsCard">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="Replio" />
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding AppVersion}" />
                                        <Button Margin="0,12,0,0" Height="44" HorizontalAlignment="Stretch" Click="WhatsNew_OnClick" Content="{Binding [WhatsNewShort], Source={x:Static platform:MobileText.Instance}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Panel>

            <!-- Big record button above the bottom bar on Home: thumb reach, the first thing to tap. While recording it
                 shows the live state and opens the live session (stopping is on the session page, never by accident). -->
            <Button x:Name="RecordFab"
                    Grid.Row="1"
                    Classes="fab"
                    Classes.live="{Binding IsCapturing}"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Click="RecordFab_OnClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="18"
                          Height="24"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2.2"
                          StrokeLineCap="Round"
                          IsVisible="{Binding !IsCapturing}"
                          Data="M 9,1 C 11,1 12,2.5 12,4 L 12,11 C 12,13 10.5,14 9,14 C 7.5,14 6,13 6,11 L 6,4 C 6,2.5 7,1 9,1 Z M 2,10 C 2,14.5 5,18 9,18 C 13,18 16,14.5 16,10 M 9,18 L 9,22 M 5.5,22.5 L 12.5,22.5" />
                    <controls:EchoListeningBars VerticalAlignment="Center" IsActive="{Binding IsCapturing}" IsVisible="{Binding IsCapturing}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="Bold"
                               Text="{Binding [RecordStart], Source={x:Static platform:MobileText.Instance}}"
                               IsVisible="{Binding !IsCapturing}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="Bold"
                               Text="{Binding [RecordOpen], Source={x:Static platform:MobileText.Instance}}"
                               IsVisible="{Binding IsCapturing}" />
                </StackPanel>
            </Button>

            <!-- Bottom bar: the three places of the app, as in Android apps. -->
            <Border x:Name="BottomNav"
                    Grid.Row="2"
                    Padding="4,6,4,8"
                    Background="{DynamicResource EchoHeaderBrush}"
                    BorderBrush="{DynamicResource EchoBorderBrush}"
                    BorderThickness="0,1,0,0">
                <UniformGrid Columns="2">
                    <Button Classes="navItem"
                            Classes.active="{Binding SelectedMainPage, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Home}"
                            Command="{Binding GoHomeCommand}">
                        <StackPanel>
                            <Border Classes="navIcon">
                                <Path Width="22" Height="22" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M 2,10 L 11,2.5 L 20,10 M 4.5,8 L 4.5,19.5 L 9,19.5 L 9,13.5 L 13,13.5 L 13,19.5 L 17.5,19.5 L 17.5,8" />
                            </Border>
                            <TextBlock Classes="navLabel" Text="{Binding [NavHome], Source={x:Static platform:MobileText.Instance}}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="navItem"
                            Classes.active="{Binding SelectedMainPage, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=Settings}"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel>
                            <Border Classes="navIcon">
                                <Path Width="22" Height="22" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M 11,7.5 C 13,7.5 14.5,9 14.5,11 C 14.5,13 13,14.5 11,14.5 C 9,14.5 7.5,13 7.5,11 C 7.5,9 9,7.5 11,7.5 Z M 11,1.5 L 11,4 M 11,18 L 11,20.5 M 1.5,11 L 4,11 M 18,11 L 20.5,11 M 4.3,4.3 L 6,6 M 16,16 L 17.7,17.7 M 4.3,17.7 L 6,16 M 16,6 L 17.7,4.3" />
                            </Border>
                            <TextBlock Classes="navLabel" Text="{Binding L[SettingsTab]}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- Setting Replio up for calls: the steps that are still off, each with its button; over the page, scrolls. -->
        <Grid x:Name="CallSetupSheet" Background="#99000000" IsVisible="False" PointerPressed="CallSetupSheetBackdrop_OnPointerPressed">
            <Border x:Name="CallSetupPanel"
                    VerticalAlignment="Bottom"
                    Padding="16,14,16,20"
                    CornerRadius="22,22,0,0"
                    Background="{DynamicResource EchoSurfaceBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="CallSetupTitle" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{DynamicResource EchoTextBrush}" />
                        <Button Grid.Column="1" Classes="ghost icon" Click="CloseCallSetup_OnClick" Content="✕" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0" Spacing="14">
                            <!-- On / off for the whole calls mode: off, no button on calls and no «Ждёт звонка». -->
                            <Border Padding="16,10,10,10" CornerRadius="18" BorderThickness="1" Background="{DynamicResource EchoSurfaceAltBrush}" BorderBrush="{DynamicResource EchoBorderBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="CallWatchTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" />
                                        <TextBlock x:Name="CallWatchText" FontSize="13" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CallWatchSwitch" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" OnContent="" OffContent="" IsCheckedChanged="CallWatch_OnChanged">
                                        <ToggleSwitch.Resources>
                                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#5EF0C1" />
                                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5EF0C1" />
                                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4AD9AC" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0E1116" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0E1116" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0E1116" />
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CallSetupStatus" FontSize="14.5" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource EchoSoftTextBrush}" />
                            <StackPanel x:Name="CallSetupList" Spacing="14" />
                            <TextBlock x:Name="CallSpeakerNote" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Source of the knowledge base: its parsed text and actions, over the page. -->
        <Grid x:Name="KnowledgeSheet" RowDefinitions="Auto,Auto,*" Background="{DynamicResource EchoBgBrush}" IsVisible="False">
            <Border Padding="12,8" Background="{DynamicResource EchoHeaderBrush}" BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Classes="accent" Height="40" Padding="12,0,16,0" Click="CloseKnowledgeSheet_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="14" VerticalAlignment="Center" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Data="M 7,1 L 1,7 L 7,13 M 1,7 L 15,7" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Text="{Binding L[GoBack]}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding SelectedKnowledgeItem.Title}" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="12,10,12,0">
                <StackPanel Orientation="Horizontal">
                    <controls:EchoThinkingDots Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsTopicBusy}" />
                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding KnowledgeHeaderStatus}" />
                </StackPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Classes="accent" Margin="0,0,6,6" Padding="14,0" Command="{Binding ParseKnowledgeItemCommand}" Content="{Binding SelectedKnowledgeItem.ParseButtonText}" IsVisible="{Binding !SelectedKnowledgeItem.CanStop}" />
                    <Button Classes="dangerSoft" Margin="0,0,6,6" Padding="14,0" Command="{Binding StopKnowledgeItemCommand}" Content="{Binding L[KnowledgeStop]}" IsVisible="{Binding SelectedKnowledgeItem.CanStop}" />
                    <Button Margin="0,0,6,6" Padding="14,0" Click="EditNote_OnClick" IsVisible="{Binding SelectedKnowledgeItem.IsNote}" Content="{Binding L[KnowledgeEditNote]}" />
                    <Button Margin="0,0,6,6" Padding="14,0" Click="OpenKnowledgeOriginal_OnClick" IsVisible="{Binding SelectedKnowledgeItem.HasOriginal}" Content="{Binding L[KnowledgeOpenOriginal]}" />
                    <Button Margin="0,0,6,6" Padding="14,0" Command="{Binding CopyKnowledgePreviewCommand}" Content="{Binding L[CopyText]}" />
                    <Button Classes="dangerSoft" Margin="0,0,6,6" Padding="14,0" Click="RemoveKnowledgeItem_OnClick" Content="{Binding L[KnowledgeRemove]}" />
                </WrapPanel>
            </StackPanel>
            <Border Grid.Row="2" Margin="12,6,12,12" Classes="card">
                <Grid>
                    <controls:MarkdownDocumentView Markdown="{Binding KnowledgePreviewText}" IsVisible="{Binding HasKnowledgePreview}" />
                    <TextBlock Margin="0,30,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding KnowledgeEmptyText}" IsVisible="{Binding !HasKnowledgePreview}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Dialogs and action sheets (MainView.Dialogs.cs fills them). -->
        <!-- Short confirmations («Скопировано», «Добавлено: 3») on every page, like the feedback line on the computer. -->
        <Border Margin="16,66,16,0"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="20"
                BorderThickness="1"
                Background="{DynamicResource EchoPopupBrush}"
                BorderBrush="{DynamicResource EchoAccentSoftBorderBrush}"
                IsHitTestVisible="False"
                IsVisible="{Binding ActionFeedbackText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoAccentTextBrush}" Text="{Binding ActionFeedbackText}" />
        </Border>

        <Grid x:Name="DialogLayer" Background="#99000000" IsVisible="False" PointerPressed="DialogLayer_OnPointerPressed">
            <Border x:Name="DialogCard"
                    Margin="16"
                    MaxWidth="460"
                    Padding="18,16"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Background="{DynamicResource EchoPopupBrush}"
                    BorderBrush="{DynamicResource EchoBorderBrush}"
                    BorderThickness="1">
                <StackPanel x:Name="DialogContent" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
