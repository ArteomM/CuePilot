<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Replio.Android.App"
             Name="Replio"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Replio/Themes/Echo.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Replio/Themes/EchoPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="EchoFont">avares://Replio/Assets/Fonts#Manrope</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
