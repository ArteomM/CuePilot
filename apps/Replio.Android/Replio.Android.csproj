<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Replio for Android phones on Avalonia. Models, Services and ViewModels are shared with ../ReplioDesktop,
    the Echo theme and controls with ../Replio.Avalonia. Platform/ holds the phone parts: microphone capture and
    media decoding, speech recognition through the API or whisper.cpp built into the APK (native/), file and
    folder pickers and the view model hooks.
    Views/ is a phone layout of the same pages: Home with topics, a session, settings.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!-- Platform/LocalWhisper.cs calls whisper.cpp through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Replio.Android</RootNamespace>
    <!-- Same assembly name as the Mac app, so avares://Replio/... in the shared theme resolves. -->
    <AssemblyName>Replio</AssemblyName>
    <ApplicationId>ru.replio.app</ApplicationId>
    <ApplicationTitle>Replio</ApplicationTitle>
    <!-- ApplicationVersion must grow with every release so Android installs the APK over the previous one. -->
    <ApplicationVersion>114</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.4</ApplicationDisplayVersion>
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4</InformationalVersion>
    <Product>Replio</Product>
    <Company>Replio</Company>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Bindings and settings JSON use reflection: keep the app's own code whole, trim only the SDK. -->
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <!-- The emulator build of CI (-p:ReplioDemo=true) adds demo data and pages opened by an intent extra for screenshots. -->
  <PropertyGroup Condition="'$(ReplioDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);REPLIO_DEMO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Replio" RootMode="All" />
    <!-- The Android SDK adds global usings of Android.App and Android.Widget: their Application and Button clash with Avalonia's. -->
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Android" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Shared code. Capture, media transcription, diagnostics and the speech model catalog have phone versions
       in Platform/ (same class names). -->
  <ItemGroup>
    <Compile Include="..\ReplioDesktop\Models\**\*.cs" Link="Shared\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ReplioDesktop\Services\**\*.cs"
             Exclude="..\ReplioDesktop\Services\HotkeyManager.cs;..\ReplioDesktop\Services\HotkeyGesture.cs;..\ReplioDesktop\Services\ScreenShareProtection.cs;..\ReplioDesktop\Services\VisualContextCaptureService.cs;..\ReplioDesktop\Services\CaptureOrchestratorService.cs;..\ReplioDesktop\Services\EnvironmentDiagnosticsService.cs;..\ReplioDesktop\Services\MediaTranscriptionService.cs;..\ReplioDesktop\Services\SpeechModelCatalog.cs;..\ReplioDesktop\Services\LocalizationService.cs"
             Link="Shared\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ReplioDesktop\ViewModels\**\*.cs" Exclude="..\ReplioDesktop\ViewModels\**\*.Wpf.cs"
             Link="Shared\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ReplioDesktop\Views\Controls\MarkdownBlocks.cs" Link="Shared\Views\MarkdownBlocks.cs" />
    <EmbeddedResource Include="..\ReplioDesktop\Resources\Strings.resx" ManifestResourceName="ReplioDesktop.Resources.Strings" Link="Shared\Resources\Strings.resx" />
    <EmbeddedResource Include="..\ReplioDesktop\Resources\Strings.ru.resx" ManifestResourceName="ReplioDesktop.Resources.Strings.ru" Link="Shared\Resources\Strings.ru.resx" />
    <AvaloniaResource Include="..\ReplioDesktop\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\ReplioDesktop\replio-icon.png" Link="Assets\replio-icon.png" />
  </ItemGroup>

  <!-- whisper.cpp for 64-bit phones, built by native/build-android.sh (in CI before the APK). Nothing else in
       native/ belongs to the app (a local whisper.cpp checkout has Java and C# bindings of its own). -->
  <ItemGroup>
    <Compile Remove="native\**" />
    <AndroidJavaSource Remove="native\**" />
    <None Remove="native\**" />
    <AndroidNativeLibrary Include="native\out\arm64-v8a\*.so" Abi="arm64-v8a" />
  </ItemGroup>

  <!-- Echo theme and controls of the Mac app. -->
  <ItemGroup>
    <AvaloniaXaml Include="..\Replio.Avalonia\Themes\Echo.axaml" Link="Themes\Echo.axaml" />
    <AvaloniaXaml Include="..\Replio.Avalonia\Themes\EchoPalette.axaml" Link="Themes\EchoPalette.axaml" />
    <AvaloniaXaml Include="..\Replio.Avalonia\Views\Controls\ModelPicker.axaml" Link="Views\Controls\ModelPicker.axaml" />
    <Compile Include="..\Replio.Avalonia\Views\Controls\ModelPicker.axaml.cs" Link="Views\Controls\ModelPicker.axaml.cs" DependentUpon="ModelPicker.axaml" />
    <Compile Include="..\Replio.Avalonia\Views\Controls\EchoMotion.cs" Link="Views\Controls\EchoMotion.cs" />
    <Compile Include="..\Replio.Avalonia\Views\Controls\GraphView.cs" Link="Views\Controls\GraphView.cs" />
    <Compile Include="..\Replio.Avalonia\Views\Controls\Markdown.cs" Link="Views\Controls\Markdown.cs" />
    <Compile Include="..\Replio.Avalonia\Views\Controls\ViewHelpers.cs" Link="Views\Controls\ViewHelpers.cs" />
    <Compile Include="..\Replio.Avalonia\Views\Controls\ThumbnailImage.cs" Link="Views\Controls\ThumbnailImage.cs" />
  </ItemGroup>

  <!-- Manrope for the native views over a call (Platform/Calls/CallUi.cs). -->
  <ItemGroup>
    <AndroidAsset Include="..\ReplioDesktop\Assets\Fonts\Manrope-*.ttf" Link="Assets\fonts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
