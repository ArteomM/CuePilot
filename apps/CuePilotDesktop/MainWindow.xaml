                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{Binding SecondaryTextBrush}" Text="{Binding L[HotkeyClearChat]}" />
                            <TextBox Grid.Column="1" Text="{Binding ClearChatHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{Binding SecondaryTextBrush}" Text="Ctrl+R" />
                        </Grid>
                        <Grid ToolTip="{Binding L[TipHotkeyStartStop]}" Background="Transparent" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{Binding SecondaryTextBrush}" Text="{Binding L[HotkeyStartStop]}" />
                            <TextBox Grid.Column="1" Text="{Binding ToggleCaptureHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{Binding SecondaryTextBrush}" Text="Ctrl+Shift+/" />
                        </Grid>
                        <Grid ToolTip="{Binding L[TipHotkeyMove]}" Background="Transparent" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{Binding SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding L[HotkeyMove]}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="50" Margin="0,0,6,0" Text="{Binding MoveLeftHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="50" Margin="0,0,6,0" Text="{Binding MoveRightHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="50" Margin="0,0,6,0" Text="{Binding MoveUpHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="50" Text="{Binding MoveDownHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{Binding SecondaryTextBrush}" Text="Alt+←→↑↓" />
                        </Grid>
                        <Grid ToolTip="{Binding L[TipHotkeyScroll]}" Background="Transparent" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{Binding SecondaryTextBrush}" Text="{Binding L[HotkeyScroll]}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="90" Margin="0,0,6,0" Text="{Binding ScrollUpHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="90" Text="{Binding ScrollDownHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{Binding SecondaryTextBrush}" Text="Ctrl+Shift+Up/Down" />
                        </Grid>
                        <Grid ToolTip="{Binding L[TipHotkeySnapshot]}" Background="Transparent" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{Binding SecondaryTextBrush}" Text="{Binding L[HotkeySnapshot]}" />
                            <TextBox Grid.Column="1" Text="{Binding SnapshotHotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{Binding SecondaryTextBrush}" Text="Ctrl+Shift+S" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button MinWidth="170" Height="34" Padding="10,0" Command="{Binding SaveSettingsCommand}" ToolTip="{Binding L[TipSaveSettings]}" Content="{Binding L[SaveSettings]}" />
                            <Button MinWidth="170" Height="34" Padding="10,0" Margin="8,0,0,0" Command="{Binding RunAudioTestCommand}" ToolTip="{Binding L[TipTestMicrophone]}" Content="{Binding L[TestMicrophone]}" />
                            <Button MinWidth="190" Height="34" Padding="10,0" Margin="8,0,0,0" Command="{Binding RunAudioCaptureTestCommand}" ToolTip="{Binding L[TipTestAudioCapture]}" Content="{Binding L[TestAudioCapture]}" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" Foreground="{Binding PrimaryTextBrush}" Text="{Binding AudioHealthMessage}" />
                        <TextBlock Margin="0,6,0,0" Foreground="{Binding SecondaryTextBrush}" Text="{Binding SystemStatsText}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{Binding SecondaryTextBrush}" Text="{Binding MicStatsText}" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
