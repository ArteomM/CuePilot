<Window x:Class="CuePilotDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:CuePilotDesktop.Views.Controls"
        mc:Ignorable="d"
        Title="{Binding L[MainWindowTitle]}"
        Icon="/cuepilot-favicon.ico"
        Background="{Binding WindowBackgroundBrush}"
        FontFamily="{StaticResource EchoFont}"
        UseLayoutRounding="True"
        Height="860"
        Width="1280"
        MinHeight="680"
        MinWidth="980">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Tabs inside a topic: text with an accent underline when selected. -->
        <Style x:Key="TopicTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="2,4,2,12" VerticalAlignment="Center" />
                            <Border x:Name="Underline"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource EchoAccentBrush}"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabCountStyle" TargetType="Border">
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceAltBrush}" />
        </Style>

        <!-- Rows of «База знаний»: the selected row is a soft accent card. -->
        <Style x:Key="KnowledgeListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Margin="0,0,0,4"
                                Padding="10,9"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource EchoHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Suggested questions on the empty «Вопросы» tab. -->
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource EchoButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RoundedButtonStyle" TargetType="Button" BasedOn="{StaticResource EchoButtonStyle}" />
        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}" />
        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource EchoButtonStyle}" />
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="6"
                                    Background="{DynamicResource EchoBgBrush}"
                                    BorderBrush="{DynamicResource EchoCheckBorderBrush}"
                                    BorderThickness="1" />
                            <Path x:Name="Mark"
                                  Margin="-15,1,0,0"
                                  Visibility="Collapsed"
                                  StrokeThickness="2"
                                  Stroke="{DynamicResource EchoAccentInkBrush}"
                                  Data="M 2 8 L 6 12 L 13 3" />
                            <ContentPresenter x:Name="Label"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource EchoAccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Margin" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}" />

        <!-- Checkbox of a knowledge source, shown only while selecting several sources. -->
        <Style x:Key="KnowledgeCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsKnowledgeSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- «×» on a hovered source; hidden while selecting several. -->
        <Style x:Key="KnowledgeDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource EchoDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoDangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsKnowledgeSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsKnowledgeSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A group of settings that only works when the option above it is on: dimmed while it is off. -->
        <Style x:Key="DependentSettingsStyle" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill segments for choices such as theme and language. -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Height="36"
                                MinWidth="120"
                                Padding="16,0"
                                CornerRadius="18"
                                Background="{DynamicResource EchoSurfaceAltBrush}"
                                BorderBrush="{DynamicResource EchoBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource EchoHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource EchoInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CaretBrush" Value="{DynamicResource EchoAccentTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource EchoAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource EchoHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}" />
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
        </Style>
        <!-- History rows: no system selection highlight, the card itself shows hover and checked states. -->
        <Style x:Key="PlainListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Transparent background: the gap between the card and its delete button keeps the row hovered. -->
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopicListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource EchoSurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
        </Style>
        <!-- Invisible until the row is hovered, but always hit-testable so moving onto it keeps it shown. -->
        <Style x:Key="DeleteSessionButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource EchoDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoDangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SessionCardButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoCardBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A question of «Вопросы»: a card like a session, accent while checked. -->
        <Style x:Key="QuestionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EchoCardBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuestionHeaderButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderBorder" Padding="18,13,16,12" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource EchoHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- «×» on a hovered question; hidden while selecting several and while the answer is still coming. -->
        <Style x:Key="QuestionDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource DeleteSessionButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsQuestionSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsQuestionSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VisibleWhenSelectionMode" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HiddenWhenSelectionMode" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="10,8"
                Background="{DynamicResource EchoHeaderBrush}"
                BorderBrush="{DynamicResource EchoBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back: an accent pill with an arrow and a label, so it stands out inside a session; faded on Home where it does nothing. -->
                <Button Height="34"
                        Padding="12,0,16,0"
                        Command="{Binding GoHomeCommand}"
                        ToolTip="{Binding L[TipGoHome]}"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EchoAccentButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16"
                              Height="14"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 7,1 L 1,7 L 7,13 M 1,7 L 15,7" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Text="{Binding L[GoBack]}" />
                    </StackPanel>
                </Button>

                <TextBox Grid.Column="1"
                         Margin="14,0"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Foreground="{Binding SecondaryTextBrush}"
                         ToolTip="{Binding L[TipSearch]}"
                         Text="{Binding SessionQuery, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="36"
                            Height="34"
                            Margin="0,0,8,0"
                            Padding="0"
                            FontSize="15"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding L[TipToggleTheme]}">
                        <Grid Width="18" Height="18">
                            <!-- Night theme: a sun (switch to day). -->
                            <Canvas Width="18" Height="18" Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="8" Height="8" Fill="{DynamicResource EchoTextBrush}" />
                                <Path Stroke="{DynamicResource EchoTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M9,1 L9,2.6 M9,15.4 L9,17 M1,9 L2.6,9 M15.4,9 L17,9 M3.3,3.3 L4.5,4.5 M13.5,13.5 L14.7,14.7 M3.3,14.7 L4.5,13.5 M13.5,4.5 L14.7,3.3" />
                            </Canvas>
                            <!-- Day theme: a crescent moon (switch to night). -->
                            <Path Visibility="{Binding IsLightTheme, Converter={StaticResource BoolToVisibility}}"
                                  Fill="{DynamicResource EchoTextBrush}"
                                  Data="M11.5,2 A7,7 0 1 0 16,12.5 A5.6,5.6 0 1 1 11.5,2 Z" />
                        </Grid>
                    </Button>
                    <Button Width="180"
                            Height="34"
                            Margin="0,0,8,0"
                            Command="{Binding OpenModesCommand}"
                            ToolTip="{Binding L[TipModes]}"
                            Content="{Binding ModesButtonText}" />
                    <Button Width="110"
                            Height="34"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="{Binding L[TipSettings]}"
                            Content="{Binding L[SettingsTab]}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="MainPages"
                    SelectionChanged="MainPages_OnSelectionChanged"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding SelectedMainPage, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.Resources>
            <TabItem Tag="Home">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Compact hero: logo, status pills and the main action in one row. -->
                    <Border Background="{DynamicResource EchoHeroBrush}" BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="24,12,28,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:EchoLogo Width="42"
                                                   Height="42"
                                                   Margin="-4,0,4,0"
                                                   IsAnimating="{Binding IsCapturing}" />
                                <TextBlock FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{DynamicResource EchoTextBrush}"><Run Text="Cue" /><Run Foreground="{DynamicResource EchoAccentTextBrush}" Text="Pilot" /></TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" Margin="22,0,0,0" Height="32" Padding="12,0" CornerRadius="16" VerticalAlignment="Center" BorderThickness="1" ToolTip="{Binding L[ScreenShareBadgeHint]}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInScreenShare}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource EchoSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <Ellipse x:Name="ShareBadgeHalo" Width="14" Height="14" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource EchoAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowInScreenShare}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:2.2" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.6" To="1.4" Duration="0:0:2.2" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.6" To="1.4" Duration="0:0:2.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource EchoAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowInScreenShare}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource EchoMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                    <!-- The text stays the same; the dot lights up while the windows are hidden from the share. -->
                                    <TextBlock Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding L[HiddenFromShareBadge]}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource EchoBadgeTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowInScreenShare}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource EchoSoftTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Button x:Name="WhatsNewButton"
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Padding="12,0"
                                    FontSize="13"
                                    Foreground="{DynamicResource EchoSoftTextBrush}"
                                    ToolTip="{Binding L[TipWhatsNew]}"
                                    Command="{Binding ToggleWhatsNewCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PillBorder"
                                                Background="{DynamicResource EchoSurfaceBrush}"
                                                BorderBrush="{DynamicResource EchoBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                            <Grid>
                                                <Border x:Name="HoverLayer" CornerRadius="16" Background="{DynamicResource EchoHoverLayerBrush}" Opacity="0" />
                                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource EchoAccentBrush}" VerticalAlignment="Center" />
                                                    <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock FontWeight="SemiBold" Text="{Binding WhatsNewButtonText}" />
                            </Button>
                            <Popup IsOpen="{Binding IsWhatsNewOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=WhatsNewButton}"
                                   Placement="Bottom"
                                   VerticalOffset="10"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Width="440"
                                        Padding="20,18"
                                        CornerRadius="18"
                                        Background="{DynamicResource EchoPopupBrush}"
                                        BorderBrush="{DynamicResource EchoBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                                       FontSize="18"
                                                       FontWeight="ExtraBold"
                                                       Text="{Binding WhatsNewTitle}" />
                                            <Button DockPanel.Dock="Right"
                                                    Width="28"
                                                    Height="24"
                                                    Margin="10,0,0,0"
                                                    Padding="0"
                                                    Command="{Binding CloseWhatsNewCommand}"
                                                    ToolTip="{Binding L[TipClose]}"
                                                    Content="✕" />
                                        </DockPanel>
                                        <TextBlock Margin="0,12,0,0"
                                                   Foreground="{Binding SecondaryTextBrush}"
                                                   FontSize="14"
                                                   LineHeight="22"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding L[WhatsNewBody]}" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button Grid.Column="4"
                                    MinWidth="200"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Command="{Binding StartCaptureCommand}"
                                    Style="{StaticResource EchoAccentButtonStyle}"
                                    ToolTip="{Binding L[TipStartCapture]}"
                                    Content="{Binding L[StartCuePilot]}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="{DynamicResource EchoBgBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Topics: drop sessions on a row to group them. -->
                        <Border BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,0,1,0" Padding="14,18,12,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="10,0,0,10"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource EchoMutedBrush}"
                                           Text="{Binding L[TopicsTitle]}" />
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Margin="10,10,4,10"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource EchoMutedBrush}"
                                               Text="{Binding L[TopicsDragHint]}" />
                                    <Button Height="36"
                                            Command="{Binding CreateTopicCommand}"
                                            ToolTip="{Binding L[TipCreateTopic]}"
                                            Content="{Binding L[TopicCreate]}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding TopicItems}"
                                         SelectedItem="{Binding SelectedTopicItem, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource TopicListBoxItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TopicRow"
                                                    Padding="10,8"
                                                    CornerRadius="10"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="Transparent"
                                                    AllowDrop="{Binding AcceptsDrop}"
                                                    DragEnter="TopicRow_OnDragEnter"
                                                    DragOver="TopicRow_OnDragOver"
                                                    DragLeave="TopicRow_OnDragLeave"
                                                    Drop="TopicRow_OnDrop"
                                                    ToolTip="{Binding DataContext.L[TipTopicRow], RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TopicName"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource EchoTextBrush}"
                                                               Text="{Binding Name}" />
                                                    <Ellipse Grid.Column="1"
                                                             Width="7"
                                                             Height="7"
                                                             Margin="8,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource EchoAccentBrush}"
                                                             ToolTip="{Binding DataContext.L[TipTopicStale], RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="8,0,0,0"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource EchoMutedBrush}"
                                                               Text="{Binding SessionCount}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter TargetName="TopicRow" Property="Background" Value="{DynamicResource EchoDropTargetBrush}" />
                                                    <Setter TargetName="TopicRow" Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTopic}" Value="False">
                                                    <Setter TargetName="TopicName" Property="Foreground" Value="{DynamicResource EchoSoftTextBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1" Margin="28,18,28,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="24"
                                               FontWeight="ExtraBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EchoTextBrush}"
                                               MaxWidth="460"
                                               TextTrimming="CharacterEllipsis"
                                               MouseLeftButtonDown="TopicTitle_OnMouseLeftButtonDown"
                                               Text="{Binding LibraryTitle}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingTopicName}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTopicSelected}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding L[TipRenameTopic]}" />
                                                        <Setter Property="Cursor" Value="IBeam" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TopicNameEditTextBox"
                                             Width="360"
                                             Height="38"
                                             FontSize="18"
                                             VerticalContentAlignment="Center"
                                             KeyDown="TopicNameEditTextBox_OnKeyDown"
                                             LostKeyboardFocus="TopicNameEditTextBox_OnLostKeyboardFocus"
                                             Text="{Binding EditableTopicName, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditingTopicName, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Margin="12,0,0,0"
                                            Padding="10,3"
                                            VerticalAlignment="Center"
                                            CornerRadius="11"
                                            Background="{DynamicResource EchoSurfaceAltBrush}">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding VisibleSessionsCount}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTopicSelected, Converter={StaticResource BoolToVisibility}}">
                                        <Button Margin="10,0,0,0"
                                                Height="32"
                                                Style="{StaticResource EchoGhostButtonStyle}"
                                                Command="{Binding StartRenameTopicCommand}"
                                                ToolTip="{Binding L[TipRenameTopic]}"
                                                Content="{Binding L[TopicRename]}" />
                                        <Button Margin="2,0,0,0"
                                                Height="32"
                                                Style="{StaticResource EchoGhostButtonStyle}"
                                                Command="{Binding DeleteTopicCommand}"
                                                ToolTip="{Binding L[TipDeleteTopic]}"
                                                Content="{Binding L[TopicDelete]}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource EchoAccentTextBrush}"
                                               Text="{Binding ActionFeedbackText}" />
                                    <!-- Selection and bulk actions belong to the session list. -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSessionsPanel, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Style="{StaticResource HiddenWhenSelectionMode}">
                                            <Button Height="34"
                                                    Padding="14,0"
                                                    Command="{Binding ToggleSelectionModeCommand}"
                                                    ToolTip="{Binding L[TipSelectMode]}"
                                                    Content="{Binding L[SelectSessions]}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Style="{StaticResource VisibleWhenSelectionMode}">
                                            <Button Height="34"
                                                    Padding="14,0"
                                                    Command="{Binding SelectAllSessionsCommand}"
                                                    ToolTip="{Binding L[TipSelectAll]}"
                                                    Content="{Binding L[SelectAllSessions]}" />
                                            <Button x:Name="MoveCheckedButton"
                                                    Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="14,0"
                                                    IsEnabled="{Binding HasCheckedSessions}"
                                                    Click="MoveCheckedButton_OnClick"
                                                    ToolTip="{Binding L[TipMoveChecked]}"
                                                    Content="{Binding L[MoveToTopic]}" />
                                            <Button Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="14,0"
                                                    Background="{DynamicResource EchoDangerSoftBrush}"
                                                    BorderBrush="{DynamicResource EchoDangerBorderBrush}"
                                                    Foreground="{DynamicResource EchoDangerTextBrush}"
                                                    Command="{Binding DeleteCheckedSessionsCommand}"
                                                    ToolTip="{Binding L[TipDeleteChecked]}"
                                                    Content="{Binding DeleteCheckedText}" />
                                            <Button Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="14,0"
                                                    Style="{StaticResource EchoAccentButtonStyle}"
                                                    FontSize="14"
                                                    Command="{Binding ToggleSelectionModeCommand}"
                                                    ToolTip="{Binding L[TipSelectDone]}"
                                                    Content="{Binding L[SelectDone]}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Tabs of a topic: sessions, summary, knowledge base, questions, graph. -->
                            <Border Grid.Row="1"
                                    Margin="0,12,0,0"
                                    BorderBrush="{DynamicResource EchoBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Visibility="{Binding IsTopicSelected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="TopicTab" Style="{StaticResource TopicTabStyle}" IsChecked="{Binding IsTopicTabSessions, Mode=TwoWay}" ToolTip="{Binding L[TipTopicTabSessions]}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding L[TopicTabSessions]}" />
                                            <Border Style="{StaticResource TabCountStyle}">
                                                <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{Binding VisibleSessionsCount}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="TopicTab" Style="{StaticResource TopicTabStyle}" IsChecked="{Binding IsTopicTabSummary, Mode=TwoWay}" ToolTip="{Binding L[TipTopicTabSummary]}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding L[TopicTabSummary]}" />
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="6,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource EchoAccentBrush}"
                                                     Visibility="{Binding IsTopicKnowledgeStale, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="TopicTab" Style="{StaticResource TopicTabStyle}" IsChecked="{Binding IsTopicTabKnowledge, Mode=TwoWay}" ToolTip="{Binding L[TipTopicTabKnowledge]}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding L[TopicTabKnowledge]}" />
                                            <Border Style="{StaticResource TabCountStyle}">
                                                <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{Binding KnowledgeSourcesCount}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="TopicTab" Style="{StaticResource TopicTabStyle}" IsChecked="{Binding IsTopicTabQuestions, Mode=TwoWay}" ToolTip="{Binding L[TipTopicTabQuestions]}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding L[TopicTabQuestions]}" />
                                            <Border Style="{StaticResource TabCountStyle}">
                                                <TextBlock FontSize="12" HorizontalAlignment="Center" Text="{Binding TopicQuestionsCount}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="TopicTab" Style="{StaticResource TopicTabStyle}" IsChecked="{Binding IsTopicTabGraph, Mode=TwoWay}" ToolTip="{Binding L[TipTopicTabGraph]}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding L[TopicTabGraph]}" />
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="6,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource EchoAccentBrush}"
                                                     Visibility="{Binding IsGraphStale, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- «Сессии»: the session list (also the whole view for «Все сессии» and «Без темы»). -->
                            <Grid Grid.Row="2" Visibility="{Binding ShowSessionsPanel, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                           Margin="2,24,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource EchoMutedBrush}"
                                           Text="{Binding L[TopicEmptyHint]}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisibleSessionsCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox
                                         Margin="0,6,0,0"
                                         ItemsSource="{Binding CompletedSessionsView}"
                                         ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="2,14,0,10"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource EchoMutedBrush}"
                                                               Text="{Binding Name}" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Margin="2,0,14,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          ToolTip="{Binding DataContext.L[TipCheckSession], RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SessionCardButtonStyle}"
                                                        Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        PreviewMouseLeftButtonDown="SessionCard_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="SessionCard_OnPreviewMouseMove"
                                                        ContextMenuOpening="SessionCard_OnContextMenuOpening"
                                                        ToolTip="{Binding DataContext.L[TipOpenSession], RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu />
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{DynamicResource EchoTextBrush}"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Title}" />
                                                        <Border Grid.Column="1"
                                                                Margin="16,0,0,0"
                                                                Padding="10,3"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="11"
                                                                BorderThickness="1"
                                                                Background="{DynamicResource EchoAccentSoftBrush}"
                                                                BorderBrush="{DynamicResource EchoAccentSoftBorderBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TopicName}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock MaxWidth="180"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EchoBadgeTextBrush}"
                                                                       Text="{Binding TopicName}" />
                                                        </Border>
                                                        <Border Grid.Column="2"
                                                                Margin="12,0,0,0"
                                                                Padding="10,4"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="11"
                                                                Background="{DynamicResource EchoSurfaceAltBrush}">
                                                            <TextBlock Foreground="{DynamicResource EchoMutedBrush}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Usage.SessionDurationText}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3"
                                                                   Margin="18,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource EchoMutedBrush}"
                                                                   FontSize="15"
                                                                   Text="{Binding StartedAt, StringFormat={}{0:t}}" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Width="34"
                                                        Height="34"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource DeleteSessionButtonStyle}"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding DataContext.L[TipDeleteSession], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Content="×" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- «Сводка»: what the topic knows, gathered by the model from its sessions and parsed materials. -->
                            <Border Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Padding="24,16,16,14"
                                    CornerRadius="16"
                                    Background="{DynamicResource EchoSurfaceBrush}"
                                    BorderBrush="{DynamicResource EchoBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding ShowSummaryPanel, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="18"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource EchoTextBrush}"
                                                       Text="{Binding L[KnowledgeSummaryTitle]}" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <controls:EchoThinkingDots Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsTopicBusy, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding TopicKnowledgeStatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTopicKnowledgeStale}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Height="34"
                                                    Padding="14,0"
                                                    Command="{Binding CopyTopicKnowledgeCommand}"
                                                    ToolTip="{Binding L[TipCopyTopicKnowledge]}"
                                                    Content="{Binding L[CopyText]}" />
                                            <Button Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="16,0"
                                                    FontSize="14"
                                                    Style="{StaticResource EchoAccentButtonStyle}"
                                                    Command="{Binding RefreshTopicKnowledgeCommand}"
                                                    ToolTip="{Binding L[TipRefreshTopicKnowledge]}"
                                                    Content="{Binding L[TopicRefreshKnowledge]}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid Margin="0,12,0,0">
                                            <controls:MarkdownDocumentView Markdown="{Binding TopicKnowledgeText}"
                                                                           Visibility="{Binding HasTopicKnowledge, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock MaxWidth="480"
                                                       Margin="0,40,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       Foreground="{DynamicResource EchoMutedBrush}"
                                                       Text="{Binding L[KnowledgeSummaryEmpty]}"
                                                       Visibility="{Binding HasTopicKnowledge, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- «База знаний»: sources on the left, the parsed text of the selected one on the right. -->
                            <!-- Files, folders and text can also be dropped here or pasted with Ctrl+V (MainWindow.TopicWorkspace.cs). -->
                            <Grid x:Name="KnowledgePanel"
                                  Grid.Row="2"
                                  Margin="0,16,0,0"
                                  AllowDrop="True"
                                  PreviewDragEnter="KnowledgePanel_OnPreviewDragOver"
                                  PreviewDragOver="KnowledgePanel_OnPreviewDragOver"
                                  PreviewDragLeave="KnowledgePanel_OnPreviewDragLeave"
                                  PreviewDrop="KnowledgePanel_OnPreviewDrop"
                                  Visibility="{Binding ShowKnowledgePanel, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="12"
                                        CornerRadius="16"
                                        Background="{DynamicResource EchoSurfaceBrush}"
                                        BorderBrush="{DynamicResource EchoBorderBrush}"
                                        BorderThickness="1">
                                    <DockPanel>
                                        <UniformGrid DockPanel.Dock="Top" Columns="2">
                                            <Button Height="36" Margin="0,0,3,3" Command="{Binding AddKnowledgeFilesCommand}" ToolTip="{Binding L[TipKnowledgeAddFiles]}" Content="{Binding L[KnowledgeAddFiles]}" />
                                            <Button Height="36" Margin="3,0,0,3" Command="{Binding AddKnowledgeFolderCommand}" ToolTip="{Binding L[TipKnowledgeAddFolder]}" Content="{Binding L[KnowledgeAddFolder]}" />
                                            <Button Height="36" Margin="0,3,3,0" Command="{Binding AddKnowledgeMediaCommand}" ToolTip="{Binding L[TipKnowledgeAddMedia]}" Content="{Binding L[KnowledgeAddMedia]}" />
                                            <Button Height="36" Margin="3,3,0,0" Command="{Binding AddKnowledgeNoteCommand}" ToolTip="{Binding L[TipKnowledgeAddNote]}" Content="{Binding L[KnowledgeAddNote]}" />
                                        </UniformGrid>
                                        <!-- Number of sources and the selection mode for removing several at once. -->
                                        <Grid DockPanel.Dock="Top"
                                              Margin="4,12,0,0"
                                              Visibility="{Binding HasKnowledgeSources, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource EchoMutedBrush}"
                                                       Text="{Binding KnowledgeSourcesSummary}"
                                                       Visibility="{Binding IsKnowledgeSelectionMode, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Height="28"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource EchoGhostButtonStyle}"
                                                    Command="{Binding SelectAllKnowledgeCommand}"
                                                    ToolTip="{Binding L[TipKnowledgeSelectAll]}"
                                                    Content="{Binding L[SelectAllSessions]}"
                                                    Visibility="{Binding IsKnowledgeSelectionMode, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Grid.Column="1"
                                                    Height="28"
                                                    Style="{StaticResource EchoGhostButtonStyle}"
                                                    Command="{Binding ToggleKnowledgeSelectionModeCommand}"
                                                    ToolTip="{Binding L[TipKnowledgeSelect]}"
                                                    Content="{Binding L[SelectSessions]}"
                                                    Visibility="{Binding IsKnowledgeSelectionMode, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Grid.Column="1"
                                                    Height="28"
                                                    Style="{StaticResource EchoGhostButtonStyle}"
                                                    Command="{Binding ToggleKnowledgeSelectionModeCommand}"
                                                    ToolTip="{Binding L[TipSelectDone]}"
                                                    Content="{Binding L[SelectDone]}"
                                                    Visibility="{Binding IsKnowledgeSelectionMode, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <StackPanel Visibility="{Binding IsKnowledgeSelectionMode, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Button Height="36"
                                                        FontSize="14"
                                                        Style="{StaticResource EchoAccentButtonStyle}"
                                                        Command="{Binding ParseAllKnowledgeCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeParseAll]}"
                                                        Content="{Binding L[KnowledgeParseAll]}"
                                                        Visibility="{Binding HasUnparsedKnowledge, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Height="32"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Center"
                                                        Style="{StaticResource EchoGhostButtonStyle}"
                                                        Command="{Binding OpenKnowledgeFolderCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeOpenFolder]}"
                                                        Content="{Binding L[KnowledgeOpenFolder]}" />
                                            </StackPanel>
                                            <Button Height="36"
                                                    FontSize="14"
                                                    Background="{DynamicResource EchoDangerSoftBrush}"
                                                    BorderBrush="{DynamicResource EchoDangerBorderBrush}"
                                                    Foreground="{DynamicResource EchoDangerTextBrush}"
                                                    Command="{Binding RemoveCheckedKnowledgeCommand}"
                                                    ToolTip="{Binding L[TipKnowledgeRemoveChecked]}"
                                                    Content="{Binding RemoveCheckedKnowledgeText}"
                                                    Visibility="{Binding IsKnowledgeSelectionMode, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Margin="4,12,4,8"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EchoMutedBrush}"
                                                   Text="{Binding L[KnowledgeListHint]}"
                                                   Visibility="{Binding HasKnowledgeSources, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ListBox Margin="0,6,0,0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 PreviewKeyDown="KnowledgeList_OnPreviewKeyDown"
                                                 ItemsSource="{Binding KnowledgeItems}"
                                                 SelectedItem="{Binding SelectedKnowledgeItem, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource KnowledgeListItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Margin="0,0,8,0"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Style="{StaticResource KnowledgeCheckBoxStyle}" />
                                                        <Border Grid.Column="1"
                                                                Width="32"
                                                                Height="32"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource EchoSurfaceAltBrush}">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="15"
                                                                       Foreground="{DynamicResource EchoAccentTextBrush}"
                                                                       Text="{Binding KindGlyph}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                            <TextBlock FontSize="14"
                                                                       FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EchoTextBrush}"
                                                                       ToolTip="{Binding Subtitle}"
                                                                       Text="{Binding Title}" />
                                                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                                <controls:EchoThinkingDots Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock x:Name="Status"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource EchoMutedBrush}"
                                                                           Text="{Binding StatusText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="3"
                                                                Width="28"
                                                                Height="28"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="16"
                                                                FontWeight="SemiBold"
                                                                Style="{StaticResource KnowledgeDeleteButtonStyle}"
                                                                Command="{Binding DataContext.RemoveKnowledgeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding DataContext.L[TipKnowledgeRemoveRow], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Content="×" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="New">
                                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Changed">
                                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource EchoDangerTextBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Padding="22,16,16,14"
                                        CornerRadius="16"
                                        Background="{DynamicResource EchoSurfaceBrush}"
                                        BorderBrush="{DynamicResource EchoBorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="18"
                                                           FontWeight="ExtraBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource EchoTextBrush}"
                                                           Text="{Binding SelectedKnowledgeItem.Title}" />
                                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                    <controls:EchoThinkingDots Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsTopicBusy, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource EchoMutedBrush}"
                                                               Text="{Binding KnowledgeHeaderStatus}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- A source: parse, edit (notes), open the original, copy, remove. -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsKnowledgeSourceSelected, Converter={StaticResource BoolToVisibility}}">
                                                <Button Height="34"
                                                        Style="{StaticResource EchoGhostButtonStyle}"
                                                        Command="{Binding RemoveKnowledgeItemCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeRemove]}"
                                                        Content="{Binding L[KnowledgeRemove]}" />
                                                <Button Height="34"
                                                        Margin="4,0,0,0"
                                                        Padding="14,0"
                                                        Command="{Binding EditKnowledgeNoteCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeEditNote]}"
                                                        Content="{Binding L[KnowledgeEditNote]}"
                                                        Visibility="{Binding SelectedKnowledgeItem.IsNote, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Height="34"
                                                        Margin="4,0,0,0"
                                                        Padding="14,0"
                                                        Command="{Binding OpenKnowledgeOriginalCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeOpenOriginal]}"
                                                        Content="{Binding L[KnowledgeOpenOriginal]}"
                                                        Visibility="{Binding SelectedKnowledgeItem.HasOriginal, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Height="34"
                                                        Margin="8,0,0,0"
                                                        Padding="14,0"
                                                        Command="{Binding CopyKnowledgePreviewCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeCopy]}"
                                                        Content="{Binding L[CopyText]}" />
                                                <Button Height="34"
                                                        Margin="8,0,0,0"
                                                        Padding="16,0"
                                                        FontSize="14"
                                                        Style="{StaticResource EchoAccentButtonStyle}"
                                                        Command="{Binding ParseKnowledgeItemCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeParse]}"
                                                        Content="{Binding SelectedKnowledgeItem.ParseButtonText}"
                                                        Visibility="{Binding SelectedKnowledgeItem.CanStop, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <Button Height="34"
                                                        Margin="8,0,0,0"
                                                        Padding="16,0"
                                                        FontSize="14"
                                                        Background="{DynamicResource EchoDangerSoftBrush}"
                                                        BorderBrush="{DynamicResource EchoDangerBorderBrush}"
                                                        Foreground="{DynamicResource EchoDangerTextBrush}"
                                                        Command="{Binding StopKnowledgeItemCommand}"
                                                        ToolTip="{Binding L[TipKnowledgeStop]}"
                                                        Content="{Binding L[KnowledgeStop]}"
                                                        Visibility="{Binding SelectedKnowledgeItem.CanStop, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{DynamicResource EchoBorderBrush}" BorderThickness="0,1,0,0">
                                            <Grid Margin="0,12,0,0">
                                                <controls:MarkdownDocumentView Markdown="{Binding KnowledgePreviewText}"
                                                                               Visibility="{Binding HasKnowledgePreview, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock MaxWidth="460"
                                                           Margin="0,40,0,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontSize="14"
                                                           LineHeight="21"
                                                           Foreground="{DynamicResource EchoMutedBrush}"
                                                           Text="{Binding KnowledgeEmptyText}"
                                                           Visibility="{Binding HasKnowledgePreview, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid x:Name="KnowledgeDropOverlay"
                                      Grid.ColumnSpan="2"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed">
                                    <Rectangle Opacity="0.9"
                                               RadiusX="16"
                                               RadiusY="16"
                                               Fill="{DynamicResource EchoDropTargetBrush}"
                                               Stroke="{DynamicResource EchoAccentBrush}"
                                               StrokeThickness="2"
                                               StrokeDashArray="5 4" />
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="22,14"
                                            CornerRadius="14"
                                            Background="{DynamicResource EchoPopupBrush}"
                                            BorderBrush="{DynamicResource EchoAccentSoftBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource EchoTextBrush}"
                                                       Text="{Binding L[KnowledgeDropHint]}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource EchoMutedBrush}"
                                                       Text="{Binding L[KnowledgeDropSubHint]}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- «Вопросы»: the question box on top, then the questions like the session list, newest first. -->
                            <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding ShowQuestionsPanel, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="8"
                                        CornerRadius="18"
                                        Background="{DynamicResource EchoSurfaceBrush}"
                                        BorderBrush="{DynamicResource EchoBorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TopicQuestionTextBox"
                                                 MinHeight="40"
                                                 MaxHeight="150"
                                                 Padding="8,9"
                                                 FontSize="14.5"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Center"
                                                 PreviewKeyDown="TopicQuestionTextBox_OnPreviewKeyDown"
                                                 ToolTip="{Binding L[TipTopicAskBox]}"
                                                 Text="{Binding TopicQuestionText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource EchoMutedBrush}"
                                                   Text="{Binding L[TopicAskPlaceholder]}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TopicQuestionTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1"
                                                Height="40"
                                                Margin="6,0,0,0"
                                                Padding="20,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="14"
                                                Style="{StaticResource EchoAccentButtonStyle}"
                                                Command="{Binding AskTopicCommand}"
                                                ToolTip="{Binding L[TipTopicAsk]}"
                                                Content="{Binding L[TopicAsk]}" />
                                    </Grid>
                                </Border>

                                <!-- Count, selection and bulk removal, as above the session list. -->
                                <Grid Grid.Row="1"
                                      Margin="2,14,0,8"
                                      Visibility="{Binding HasTopicQuestions, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource EchoMutedBrush}"
                                               Text="{Binding TopicQuestionsSummary}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Height="34"
                                                Padding="14,0"
                                                Command="{Binding ToggleQuestionSelectionModeCommand}"
                                                ToolTip="{Binding L[TipQuestionsSelect]}"
                                                Content="{Binding L[SelectSessions]}"
                                                Visibility="{Binding IsQuestionSelectionMode, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsQuestionSelectionMode, Converter={StaticResource BoolToVisibility}}">
                                            <Button Height="34"
                                                    Padding="14,0"
                                                    Command="{Binding SelectAllQuestionsCommand}"
                                                    ToolTip="{Binding L[TipQuestionsSelectAll]}"
                                                    Content="{Binding L[SelectAllSessions]}" />
                                            <Button Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="14,0"
                                                    Background="{DynamicResource EchoDangerSoftBrush}"
                                                    BorderBrush="{DynamicResource EchoDangerBorderBrush}"
                                                    Foreground="{DynamicResource EchoDangerTextBrush}"
                                                    Command="{Binding RemoveCheckedQuestionsCommand}"
                                                    ToolTip="{Binding L[TipQuestionsRemoveChecked]}"
                                                    Content="{Binding RemoveCheckedQuestionsText}" />
                                            <Button Height="34"
                                                    Margin="8,0,0,0"
                                                    Padding="14,0"
                                                    FontSize="14"
                                                    Style="{StaticResource EchoAccentButtonStyle}"
                                                    Command="{Binding ToggleQuestionSelectionModeCommand}"
                                                    ToolTip="{Binding L[TipSelectDone]}"
                                                    Content="{Binding L[SelectDone]}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2"
                                            MaxWidth="620"
                                            Margin="0,40,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding HasTopicQuestions, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="22"
                                               FontWeight="ExtraBold"
                                               Foreground="{DynamicResource EchoTextBrush}"
                                               Text="{Binding L[QuestionsEmptyTitle]}" />
                                    <TextBlock Margin="0,8,0,18"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               LineHeight="21"
                                               Foreground="{DynamicResource EchoMutedBrush}"
                                               Text="{Binding L[QuestionsEmptyHint]}" />
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion1]}" Content="{Binding L[QuestionSuggestion1]}" />
                                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion2]}" Content="{Binding L[QuestionSuggestion2]}" />
                                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion3]}" Content="{Binding L[QuestionSuggestion3]}" />
                                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding AskTopicSuggestionCommand}" CommandParameter="{Binding L[QuestionSuggestion4]}" Content="{Binding L[QuestionSuggestion4]}" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Virtualized: only the cards on screen are drawn, so a long history opens at once. -->
                                <ListBox x:Name="QuestionsList"
                                         Grid.Row="2"
                                         ItemsSource="{Binding QuestionItems}"
                                         ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Visibility="{Binding HasTopicQuestions, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Margin="2,18,14,0"
                                                          VerticalAlignment="Top"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          ToolTip="{Binding DataContext.L[TipCheckQuestion], RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Visibility="{Binding DataContext.IsQuestionSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                                <Border Grid.Column="1" Style="{StaticResource QuestionCardStyle}">
                                                    <StackPanel>
                                                        <!-- The header opens and folds the answer (checks the card while selecting). -->
                                                        <Button Style="{StaticResource QuestionHeaderButtonStyle}"
                                                                Command="{Binding DataContext.ToggleQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding DataContext.L[TipToggleQuestion], RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path x:Name="Chevron"
                                                                      Margin="0,6,0,0"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Top"
                                                                      Data="M 1,1 L 6,5.5 L 1,10"
                                                                      StrokeThickness="2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Stroke="{DynamicResource EchoAccentTextBrush}"
                                                                      RenderTransformOrigin="0.5,0.5" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock FontSize="15.5"
                                                                               FontWeight="Bold"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource EchoTextBrush}"
                                                                               Text="{Binding Question}" />
                                                                    <TextBlock x:Name="AnswerPreview"
                                                                               Margin="0,4,0,0"
                                                                               FontSize="13.5"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource EchoMutedBrush}"
                                                                               Text="{Binding AnswerPreview}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Margin="16,1,0,0"
                                                                           VerticalAlignment="Top"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource EchoMutedBrush}"
                                                                           ToolTip="{Binding CostToolTip}"
                                                                           Text="{Binding MetaText}" />
                                                            </Grid>
                                                        </Button>
                                                        <StackPanel x:Name="AnswerBody" Margin="40,0,16,12" Visibility="Collapsed">
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                                <controls:EchoThinkingDots Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock FontSize="13.5"
                                                                           Foreground="{DynamicResource EchoMutedBrush}"
                                                                           Text="{Binding DataContext.L[TopicAskBusy], RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </StackPanel>
                                                            <controls:MarkdownView Markdown="{Binding Answer}"
                                                                                   VerticalScrollBarVisibility="Disabled"
                                                                                   Visibility="{Binding IsPending, Converter={StaticResource InverseBoolToVisibility}}" />
                                                            <Button Height="28"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Right"
                                                                    Style="{StaticResource EchoGhostButtonStyle}"
                                                                    Command="{Binding DataContext.CopyTopicAnswerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding DataContext.L[TipCopyTopicAnswer], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Content="{Binding DataContext.L[CopyText], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Visibility="{Binding IsPending, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Width="34"
                                                        Height="34"
                                                        Margin="10,10,0,0"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource QuestionDeleteButtonStyle}"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Command="{Binding DataContext.RemoveQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding DataContext.L[TipRemoveQuestion], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Content="×" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter TargetName="AnswerBody" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="AnswerPreview" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter TargetName="AnswerPreview" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- «Граф»: entities and relations of the topic, like the Obsidian graph. -->
                            <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding ShowGraphPanel, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:EchoThinkingDots Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsGraphBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding GraphStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource EchoMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGraphStale}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="230" Margin="12,0,0,0" Visibility="{Binding HasGraph, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox x:Name="GraphSearchTextBox" Height="36" VerticalContentAlignment="Center" ToolTip="{Binding L[TipGraphSearch]}" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource EchoMutedBrush}"
                                                   Text="{Binding L[GraphSearchPlaceholder]}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=GraphSearchTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="2"
                                            Height="36"
                                            Margin="10,0,0,0"
                                            Padding="16,0"
                                            FontSize="14"
                                            Style="{StaticResource EchoAccentButtonStyle}"
                                            Command="{Binding BuildTopicGraphCommand}"
                                            ToolTip="{Binding L[TipGraphBuild]}"
                                            Content="{Binding BuildGraphButtonText}" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,12,0,0"
                                        CornerRadius="16"
                                        Background="{DynamicResource EchoSurfaceBrush}"
                                        BorderBrush="{DynamicResource EchoBorderBrush}"
                                        BorderThickness="1">
                                    <Grid ClipToBounds="True">
                                        <controls:GraphView x:Name="TopicGraphView"
                                                            Graph="{Binding CurrentGraph}"
                                                            Filter="{Binding Text, ElementName=GraphSearchTextBox}" />
                                        <StackPanel MaxWidth="460"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasGraph, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="20"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource EchoTextBrush}"
                                                       Text="{Binding L[GraphEmptyTitle]}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       Foreground="{DynamicResource EchoMutedBrush}"
                                                       Text="{Binding L[GraphEmptyHint]}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,0,14,10"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   IsHitTestVisible="False"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource EchoSoftTextBrush}"
                                                   Text="{Binding L[GraphControlsHint]}"
                                                   Visibility="{Binding HasGraph, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Details of the clicked node. -->
                                        <Border x:Name="GraphDetailsPanel"
                                                Width="300"
                                                Margin="12"
                                                Padding="16,14"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                CornerRadius="14"
                                                Background="{DynamicResource EchoPopupBrush}"
                                                BorderBrush="{DynamicResource EchoBorderBrush}"
                                                BorderThickness="1"
                                                Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="#000000" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                                        <Ellipse x:Name="GraphDetailsDot" Width="10" Height="10" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="GraphDetailsType"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource EchoMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Width="28"
                                                            Height="28"
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource EchoGhostButtonStyle}"
                                                            Padding="0"
                                                            Click="GraphDetailsClose_OnClick"
                                                            Content="×" />
                                                </Grid>
                                                <TextBlock x:Name="GraphDetailsTitle"
                                                           Margin="0,6,0,0"
                                                           FontSize="17"
                                                           FontWeight="ExtraBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EchoTextBrush}" />
                                                <TextBlock x:Name="GraphDetailsDescription"
                                                           Margin="0,6,0,0"
                                                           FontSize="13.5"
                                                           LineHeight="20"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EchoSoftTextBrush}" />
                                                <TextBlock Margin="0,12,0,4"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource EchoMutedBrush}"
                                                           Text="{Binding L[GraphDetailsLinks]}" />
                                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="GraphDetailsLinks">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Margin="0,0,0,2"
                                                                        Padding="8,4"
                                                                        HorizontalContentAlignment="Left"
                                                                        Style="{StaticResource EchoGhostButtonStyle}"
                                                                        Click="GraphDetailsLink_OnClick"
                                                                        Tag="{Binding Node}">
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource EchoTextBrush}" Text="{Binding Label}" />
                                                                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding Relation}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <TextBlock x:Name="GraphDetailsSources"
                                                           Margin="0,10,0,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource EchoMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Tag="Session">
                <Grid Margin="48,28,48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="{Binding SecondaryTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedSession.StartedAt, StringFormat='{}{0:dddd, dd MMM HH:mm}'}" />

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                   Name="SessionTitleTextBlock"
                                   FontSize="38"
                                   FontWeight="ExtraBold"
                                   MouseLeftButtonDown="SessionTitleTextBlock_OnMouseLeftButtonDown"
                                   Cursor="IBeam"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding L[TipRenameSession]}"
                                   Text="{Binding CurrentSessionTitle}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingSessionTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Foreground="{Binding PrimaryTextBrush}"
                                 Name="SessionTitleEditTextBox"
                                 Background="{DynamicResource EchoSurfaceBrush}"
                                 BorderBrush="{DynamicResource EchoBorderBrush}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 Padding="12,6"
                                 FontSize="30"
                                 LostKeyboardFocus="SessionTitleEditTextBox_OnLostKeyboardFocus"
                                 KeyDown="SessionTitleEditTextBox_OnKeyDown"
                                 Text="{Binding EditableSessionTitle, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingSessionTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource EchoAccentTextBrush}"
                                       Text="{Binding ActionFeedbackText}" />
                            <Button Margin="8,0,0,0" Content="{Binding L[FollowUpEmail]}" MinWidth="136" Padding="12,0" Height="34" Command="{Binding FollowUpEmailCommand}" ToolTip="{Binding L[TipFollowUpEmail]}" />
                            <Button Margin="8,0,0,0" Content="{Binding L[Regenerate]}" MinWidth="118" Padding="12,0" Height="34" Command="{Binding RegenerateSummaryCommand}" ToolTip="{Binding L[TipRegenerate]}" />
                        </StackPanel>
                    </Grid>
                    <TabControl Grid.Row="2"
                                Margin="0,20,0,0"
                                Background="{Binding SurfaceAltBrush}"
                                BorderBrush="{Binding BorderBrush}"
                                Foreground="{Binding PrimaryTextBrush}"
                                SelectedValuePath="Tag"
                                SelectedValue="{Binding SelectedSessionTab, Mode=TwoWay}">
                        <TabControl.Resources>
                            <Style TargetType="TabPanel">
                                <Setter Property="Margin" Value="10,8,0,4" />
                            </Style>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="{Binding DataContext.PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="Background" Value="{DynamicResource EchoSurfaceAltBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource EchoBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Padding" Value="12,5" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ContentPresenter x:Name="ContentSite"
                                                                  ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource EchoSelectedTabBrush}" />
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource EchoAccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Opacity" Value="0.93" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <TabItem Tag="Summary" Header="{Binding L[TabSummary]}" ToolTip="{Binding L[TipTabSummary]}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}" FontSize="26" FontWeight="ExtraBold" Text="{Binding L[SummaryDiscussionTitle]}" />
                                    <Button Grid.Column="1" Height="34" Padding="16,0" FontSize="14" VerticalAlignment="Center" Style="{StaticResource EchoAccentButtonStyle}" Command="{Binding CopySummaryCommand}" ToolTip="{Binding L[TipCopySummary]}" Content="{Binding L[CopySummary]}" />
                                </Grid>
                                <TextBox Grid.Row="1"
                                         Margin="0,18,0,0"
                                         Foreground="{Binding PrimaryTextBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="17"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Text="{Binding CurrentSessionSummary, Mode=OneWay}" />
                            </Grid>
                        </TabItem>
                        <TabItem Tag="Transcript" Header="{Binding L[TabTranscript]}" ToolTip="{Binding L[TipTabTranscript]}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}" FontSize="26" FontWeight="ExtraBold" Text="{Binding L[TabTranscript]}" />
                                    <Button Grid.Column="1" Height="34" Padding="16,0" FontSize="14" VerticalAlignment="Center" Style="{StaticResource EchoAccentButtonStyle}" Command="{Binding CopyTranscriptCommand}" ToolTip="{Binding L[TipCopyTranscript]}" Content="{Binding L[CopyTranscript]}" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                         Margin="0,18,0,0"
                                         ItemsSource="{Binding SelectedSessionTranscript}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,10"
                                                       Foreground="{Binding DataContext.PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="16"
                                                       Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Tag="Email" Header="{Binding L[TabEmail]}" ToolTip="{Binding L[TipTabEmail]}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}" FontSize="26" FontWeight="ExtraBold" Text="{Binding L[FollowUpEmailTitle]}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Height="34" Padding="14,0" Command="{Binding FollowUpEmailCommand}" ToolTip="{Binding L[TipFollowUpEmailAgain]}" Content="{Binding L[FollowUpEmailAgain]}" />
                                        <Button Height="34" Margin="8,0,0,0" Padding="16,0" FontSize="14" Style="{StaticResource EchoAccentButtonStyle}" Command="{Binding CopyFollowUpEmailCommand}" ToolTip="{Binding L[TipCopyEmail]}" Content="{Binding L[CopyEmail]}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
                                    <controls:EchoThinkingDots Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsFollowUpEmailBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock FontSize="14" TextWrapping="Wrap" MaxWidth="720" Foreground="{DynamicResource EchoMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding L[FollowUpEmailHint]}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFollowUpEmail}" Value="True">
                                                        <Setter Property="Text" Value="{Binding L[FollowUpEmailReadyHint]}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFollowUpEmailBusy}" Value="True">
                                                        <Setter Property="Text" Value="{Binding L[FollowUpEmailBusy]}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Row="2"
                                         Margin="0,16,0,0"
                                         Foreground="{Binding PrimaryTextBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontSize="16"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Text="{Binding CurrentFollowUpEmail, Mode=OneWay}" />
                            </Grid>
                        </TabItem>
                        <TabItem Tag="Usage" Header="{Binding L[TabUsage]}" ToolTip="{Binding L[TipTabUsage]}">
                            <ScrollViewer Margin="10"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock FontSize="15"
                                               Foreground="{DynamicResource EchoMutedBrush}"
                                               Text="{Binding L[SessionUsageFallback]}"
                                               Visibility="{Binding UsageView.HasData, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding UsageView.HasData, Converter={StaticResource BoolToVisibility}}">
                                        <!-- Main numbers as tiles; money and details stay folded below. -->
                                        <ItemsControl ItemsSource="{Binding UsageView.Metrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="176"
                                                            Margin="0,0,10,10"
                                                            Padding="14,10"
                                                            CornerRadius="14"
                                                            Background="{DynamicResource EchoSurfaceAltBrush}"
                                                            ToolTip="{Binding Hint}">
                                                        <StackPanel>
                                                            <TextBlock FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EchoMutedBrush}"
                                                                       Text="{Binding Label}" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       FontSize="19"
                                                                       FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource EchoTextBrush}"
                                                                       Text="{Binding Value}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander Margin="0,4,10,0"
                                                  Style="{StaticResource EchoExpanderStyle}"
                                                  Header="{Binding UsageView.CostHeader}"
                                                  ToolTip="{Binding L[TipUsageCost]}">
                                            <ItemsControl ItemsSource="{Binding UsageView.CostRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="RowLabel"
                                                                       FontSize="14"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource EchoMutedBrush}"
                                                                       Text="{Binding Label}" />
                                                            <TextBlock x:Name="RowValue"
                                                                       Grid.Column="1"
                                                                       Margin="16,0,0,0"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource EchoTextBrush}"
                                                                       Text="{Binding Value}" />
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                <Setter TargetName="RowLabel" Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
                                                                <Setter TargetName="RowLabel" Property="FontWeight" Value="Bold" />
                                                                <Setter TargetName="RowValue" Property="FontWeight" Value="Bold" />
                                                                <Setter TargetName="RowValue" Property="Foreground" Value="{DynamicResource EchoAccentTextBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <Expander Margin="0,10,10,0"
                                                  Style="{StaticResource EchoExpanderStyle}"
                                                  Header="{Binding UsageView.DialogHeader}"
                                                  ToolTip="{Binding L[TipUsageDialog]}">
                                            <TextBox Foreground="{DynamicResource EchoTextBrush}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     FontSize="14"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding UsageView.DialogText, Mode=OneWay}" />
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button MinWidth="170"
                                    Height="44"
                                    Padding="12,0"
                                    Command="{Binding StartCaptureCommand}"
                                    ToolTip="{Binding L[TipNewRecording]}"
                                    Content="{Binding L[NewRecording]}" />
                            <TextBox Grid.Column="1"
                                     Name="SessionAskTextBox"
                                     Margin="12,0,0,0"
                                     Height="44"
                                     VerticalContentAlignment="Center"
                                     MouseEnter="SessionAskTextBox_OnMouseEnter"
                                     ToolTip="{Binding L[TipAskBox]}"
                                     GotKeyboardFocus="SessionAskTextBox_OnGotKeyboardFocus"
                                     Text="{Binding OverlayPrompt, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding WhatShouldISayCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2"
                                    Margin="10,0,0,0"
                                    Width="174"
                                    Height="44"
                                    Style="{StaticResource EchoAccentButtonStyle}"
                                    Command="{Binding WhatShouldISayCommand}"
                                    ToolTip="{Binding L[TipAsk]}"
                                    Content="{Binding L[AskPrefix]}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding SecondaryTextBrush}"
                                   Text="{Binding LastVisualCaptureText}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Tag="Modes">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource EchoSurfaceBrush}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">
                        <StackPanel>
                            <Button Height="34"
                                    Command="{Binding NewModeCommand}"
                                    Content="+ Новый режим" />
                            <ListBox Margin="0,12,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemsSource="{Binding ModeOptions}"
                                     SelectedItem="{Binding ModeEditorName, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{Binding DataContext.PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="16"
                                                       Text="{Binding}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource EchoAccentTextBrush}"
                                                       Text="✓">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
