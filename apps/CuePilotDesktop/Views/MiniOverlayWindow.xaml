<Window x:Class="CuePilotDesktop.Views.MiniOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CuePilotDesktop.Views.Controls"
        FontFamily="{StaticResource EchoFont}"
        UseLayoutRounding="True"
        Title="CuePilot"
        Icon="/cuepilot-favicon.ico"
        Width="760"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Overlay windows stay in the night palette in both app themes: they float over other apps. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/EchoDarkPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="OverlayGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource EchoGhostButtonStyle}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="OverlayActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E9EEF5" />
            <Setter Property="BorderBrush" Value="#2A313C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252C36" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2C3440" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E9EEF5" />
            <Setter Property="BorderBrush" Value="#2A313C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#243A33" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#5EF0C1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#252C36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="8" Background="#EB171B22" BorderBrush="#2A313C" BorderThickness="1" CornerRadius="20" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <controls:EchoListeningBars x:Name="ListeningBars"
                                                Margin="4,0,2,0"
                                                VerticalAlignment="Center" />
                    <Button Name="CompactToggleButton"
                            Style="{StaticResource OverlayGhostButtonStyle}"
                            Foreground="#E9EEF5"
                            FontWeight="ExtraBold"
                            Click="CompactToggleButton_OnClick"
                            Content="CuePilot ▾" />
                    <Button Margin="4,0,0,0"
                            Name="WhatToSayButton"
                            Style="{StaticResource OverlayGhostButtonStyle}"
                            Content="Что сказать"
                            Click="WhatToSayButton_OnClick" />
                    <Button Margin="4,0,0,0"
                            Name="TopWhatShouldISayButton"
                            Style="{StaticResource OverlayGhostButtonStyle}"
                            Content="Что спросить"
                            Click="TopWhatShouldISayButton_OnClick" />
                    <Button Margin="4,0,0,0"
                            Name="FollowUpQuestionButton"
                            Style="{StaticResource OverlayGhostButtonStyle}"
                            Content="Уточняющие вопросы"
                            Click="FollowUpQuestionButton_OnClick" />
                    <Button Margin="4,0,0,0"
                            Name="RecapButton"
                            Style="{StaticResource OverlayGhostButtonStyle}"
                            Content="Кратко"
                            Click="RecapButton_OnClick" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Name="OverlayStatusText"
                           VerticalAlignment="Center"
                           Foreground="#9AA5B5"
                           TextTrimming="CharacterEllipsis"
                           Text="..." />
                <Button Grid.Column="2"
                        Margin="4,0,4,0"
                        Name="OpenMainButton"
                        Style="{StaticResource OverlayGhostButtonStyle}"
                        Content="↗"
                        Click="OpenMainButton_OnClick" />
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="#9AA5B5"
                           Text="Ctrl+/" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0" Name="PromptRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="12" BorderBrush="#2A313C" BorderThickness="1" Background="#CC0E1116" Padding="0">
                    <TextBox Name="OverlayPromptText"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,8"
                             Foreground="#E9EEF5"
                             CaretBrush="#5EF0C1"
                             Text="Ask anything about your conversation"
                             MouseEnter="OverlayPromptText_OnMouseEnter"
                             GotKeyboardFocus="OverlayPromptText_OnGotKeyboardFocus"
                             KeyDown="OverlayPromptText_OnKeyDown"
                             VerticalContentAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <!-- Глубокий режим переехал в настройки; переключатель оставлен скрытым для кода. -->
                    <ToggleButton Name="SmartToggle"
                                  Visibility="Collapsed"
                                  Style="{StaticResource OverlayToggleButtonStyle}"
                                  Content="Smart"
                                  Checked="SmartToggle_OnChecked"
                                  Unchecked="SmartToggle_OnUnchecked" />
                    <Button Name="WhatShouldISayButton"
                            Style="{StaticResource EchoAccentButtonStyle}"
                            MinWidth="110"
                            Height="38"
                            Content="Спросить"
                            Click="WhatShouldISayButton_OnClick" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Name="ConversationPanel"
                    Margin="0,10,0,0"
                    Padding="10"
                    CornerRadius="14"
                    BorderBrush="#2A313C"
                    BorderThickness="1"
                    Background="#990E1116">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox Name="OverlayConversationList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding ConversationItems}"
                             VirtualizingPanel.IsVirtualizing="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10"
                                        Opacity="0"
                                        CornerRadius="{Binding BubbleCornerRadius}"
                                        MaxWidth="520"
                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                        BorderBrush="{Binding BubbleBorder}"
                                        BorderThickness="1"
                                        Background="{Binding BubbleBackground}">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="10" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <!-- Each new message rises softly into the dialog. -->
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}"
                                                   Foreground="{Binding RoleBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{Binding MessageBrush}"
                                                   FontSize="14"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EchoThinkingDots x:Name="ThinkingDots"
                                               Grid.Row="1"
                                               Margin="6,2,0,2"
                                               HorizontalAlignment="Left"
                                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Name="CompactAnswerPanel"
                    Visibility="Collapsed"
                    Margin="0,10,0,0"
                    Padding="12,8"
                    CornerRadius="14"
                    BorderBrush="#2A313C"
                    BorderThickness="1"
                    Background="#CC0E1116">
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Name="CompactAnswerText"
                               Foreground="#E9EEF5"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="4"
                       Name="OverlayStatsText"
                       Margin="2,8,0,0"
                       Foreground="#9AA5B5"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Text="" />
        </Grid>
    </Border>
</Window>
