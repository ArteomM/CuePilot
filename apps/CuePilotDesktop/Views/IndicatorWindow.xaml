<Window x:Class="CuePilotDesktop.Views.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CuePilotDesktop.Views.Controls"
        FontFamily="{StaticResource EchoFont}"
        Title="CuePilot Indicator"
        Icon="/cuepilot-favicon.ico"
        Width="300"
        Height="54"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Overlay windows stay in the night palette in both app themes: they float over other apps. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/EchoDarkPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="IndicatorButtonStyle" TargetType="Button" BasedOn="{StaticResource EchoGhostButtonStyle}">
            <Setter Property="BorderBrush" Value="#2A313C" />
            <Setter Property="Foreground" Value="#E9EEF5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="4" Background="#EB171B22" BorderBrush="#2A313C" BorderThickness="1" CornerRadius="16" Padding="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Width="34"
                    Height="34"
                    Name="HomeButton"
                    Style="{StaticResource IndicatorButtonStyle}"
                    Padding="0"
                    Click="HomeButton_OnClick">
                <controls:EchoLogo x:Name="HomeLogo" Width="26" Height="26" />
            </Button>

            <Button Grid.Column="1"
                    Margin="8,0,8,0"
                    Name="HideAskButton"
                    Style="{StaticResource IndicatorButtonStyle}"
                    Content="Hide"
                    Click="HideAskButton_OnClick" />

            <Button Grid.Column="2"
                    Width="42"
                    Height="34"
                    Margin="0,0,8,0"
                    Name="StopButton"
                    Style="{StaticResource IndicatorButtonStyle}"
                    Content="■"
                    Click="StopButton_OnClick" />

            <Button Grid.Column="3"
                    Width="42"
                    Height="34"
                    Name="CaptureButton"
                    Style="{StaticResource IndicatorButtonStyle}"
                    Content="📷"
                    Click="CaptureButton_OnClick" />
        </Grid>
    </Border>
</Window>
