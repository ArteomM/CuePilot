<Window x:Class="CuePilotDesktop.Views.EchoNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource EchoFont}"
        Width="620"
        Height="560"
        MinWidth="440"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <!-- A note for the topic knowledge base: a title and free text. -->
    <Border Margin="12"
            Padding="24,20,20,18"
            CornerRadius="18"
            Background="{DynamicResource EchoSurfaceBrush}"
            BorderBrush="{DynamicResource EchoBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource EchoAccentBrush}" />
                <TextBlock x:Name="HeaderText"
                           Margin="10,0,0,0"
                           FontSize="18"
                           FontWeight="ExtraBold"
                           Foreground="{DynamicResource EchoTextBrush}" />
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EchoMutedBrush}" />
            <TextBox x:Name="TitleBox"
                     Grid.Row="2"
                     Margin="0,14,0,0"
                     Height="40"
                     FontSize="15"
                     VerticalContentAlignment="Center" />
            <TextBox x:Name="TextBox"
                     Grid.Row="3"
                     Margin="0,10,0,0"
                     Padding="10,8"
                     FontSize="14.5"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" />
            <StackPanel Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Height="38"
                        MinWidth="110"
                        Padding="16,0"
                        IsCancel="True"
                        Style="{StaticResource EchoButtonStyle}"
                        Click="CancelButton_OnClick" />
                <Button x:Name="OkButton"
                        Height="38"
                        MinWidth="140"
                        Margin="8,0,0,0"
                        Padding="18,0"
                        FontSize="14"
                        Style="{StaticResource EchoAccentButtonStyle}"
                        Click="OkButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
