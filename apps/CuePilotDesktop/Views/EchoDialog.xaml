<Window x:Class="CuePilotDesktop.Views.EchoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource EchoFont}"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <!-- Confirmation and error dialog in the «Эхо» style; follows the day/night palette of the app. -->
    <Border Margin="12"
            Padding="24,20,20,18"
            CornerRadius="18"
            Background="{DynamicResource EchoSurfaceBrush}"
            BorderBrush="{DynamicResource EchoBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Marker" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource EchoAccentBrush}" />
                <TextBlock x:Name="TitleText"
                           Margin="10,0,0,0"
                           FontSize="18"
                           FontWeight="ExtraBold"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Foreground="{DynamicResource EchoTextBrush}" />
            </StackPanel>
            <TextBlock x:Name="MessageText"
                       Margin="0,12,0,0"
                       FontSize="14"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EchoMutedBrush}" />
            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Height="38"
                        MinWidth="110"
                        Padding="16,0"
                        IsCancel="True"
                        Style="{StaticResource EchoButtonStyle}"
                        Click="CancelButton_OnClick" />
                <Button x:Name="OkButton"
                        Height="38"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="18,0"
                        FontSize="14"
                        IsDefault="True"
                        Style="{StaticResource EchoAccentButtonStyle}"
                        Click="OkButton_OnClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
