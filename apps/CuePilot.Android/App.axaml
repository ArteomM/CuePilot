<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CuePilot.Android.App"
             Name="CuePilot"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CuePilot/Themes/Echo.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CuePilot/Themes/EchoPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="EchoFont">avares://CuePilot/Assets/Fonts#Manrope</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
