<Project Sdk="Microsoft.NET.Sdk">

  <!--
    replio: command line and MCP access to Replio sessions for local AI agents (Claude Code, Codex, Cursor…).
    Reads %AppData%\Replio (sessions, topics, screenshots) and never changes it; exports go to a folder of their own.
    Published next to Replio.exe by build\build-installer.cmd.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReplioCli</RootNamespace>
    <AssemblyName>replio</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.1.1</Version>
    <Company>ИП Макаров Артём Павлович</Company>
    <Copyright>© 2026 ИП Макаров Артём Павлович</Copyright>
    <Description>Replio — команда для ИИ-агентов</Description>
    <AssemblyTitle>Replio — команда для ИИ-агентов</AssemblyTitle>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>Replio</Product>
  </PropertyGroup>

  <!-- The same session and topic classes the app saves, so the files are read exactly as the app wrote them. -->
  <ItemGroup>
    <Compile Include="..\ReplioDesktop\Models\SessionModels.cs" Link="Shared\SessionModels.cs" />
    <Compile Include="..\ReplioDesktop\Services\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\ReplioDesktop\ViewModels\ObservableObject.cs" Link="Shared\ObservableObject.cs" />
    <Compile Include="..\ReplioDesktop\Services\SpeechModelCatalog.cs" Link="Shared\SpeechModelCatalog.cs" />
    <Compile Include="..\ReplioDesktop\Services\LegacyDataImport.cs" Link="Shared\LegacyDataImport.cs" />
    <Compile Include="..\ReplioDesktop\Services\SessionScreenshots.cs" Link="Shared\SessionScreenshots.cs" />
    <Compile Include="..\ReplioDesktop\Services\AgentGuide.cs" Link="Shared\AgentGuide.cs" />
    <Compile Include="..\ReplioDesktop\Services\DataLocation.cs" Link="Shared\DataLocation.cs" />
  </ItemGroup>

</Project>
