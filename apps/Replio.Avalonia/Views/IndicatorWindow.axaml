<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Replio.Avalonia.Views.Controls"
        x:Class="Replio.Avalonia.Views.IndicatorWindow"
        FontFamily="{StaticResource EchoFont}"
        FontSize="14"
        Title="Replio Indicator"
        Icon="avares://Replio/Assets/replio-icon.png"
        Width="346"
        Height="54"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen">
    <!-- Overlay windows stay in the night palette in both app themes: they float over other apps. -->
    <Window.Styles>
        <Style Selector="Button.indicator">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#2A313C" />
            <Setter Property="Foreground" Value="#E9EEF5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </Window.Styles>
    <Border Margin="4" Background="#EB171B22" BorderBrush="#2A313C" BorderThickness="1" CornerRadius="16" Padding="6">
        <Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Button Width="34"
                    Height="34"
                    Name="HomeButton"
                    Classes="indicator"
                    Padding="0">
                <controls:EchoLogo x:Name="HomeLogo" Width="26" Height="26" />
            </Button>

            <Button Grid.Column="1"
                    Margin="8,0,8,0"
                    Name="HideAskButton"
                    Classes="indicator"
                    HorizontalAlignment="Stretch"
                    Content="Hide" />

            <Button Grid.Column="2"
                    Width="42"
                    Height="34"
                    Margin="0,0,8,0"
                    Name="StopButton"
                    Classes="indicator"
                    Content="■" />

            <Button Grid.Column="3"
                    Width="42"
                    Height="34"
                    Name="CaptureButton"
                    Classes="indicator"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    Content="📷" />

            <!-- Quick choice of the microphone, also during a recording. -->
            <Button Grid.Column="4"
                    Width="38"
                    Height="34"
                    Margin="6,0,0,0"
                    Name="DevicesButton"
                    Classes="indicator"
                    Padding="0"
                    HorizontalContentAlignment="Center">
                <Path Width="12" Height="17" Stretch="Uniform" Fill="#E9EEF5"
                      Data="M6,0 C7.7,0 9,1.3 9,3 L9,9 C9,10.7 7.7,12 6,12 C4.3,12 3,10.7 3,9 L3,3 C3,1.3 4.3,0 6,0 Z M0,8 L1.4,8 C1.4,10.6 3.5,12.6 6,12.6 C8.5,12.6 10.6,10.6 10.6,8 L12,8 C12,11 9.8,13.5 6.8,13.9 L6.8,17 L5.2,17 L5.2,13.9 C2.2,13.5 0,11 0,8 Z" />
            </Button>
        </Grid>

        <!-- What is left of the plan's limit, once it is 20 % or less (MainViewModel.Limits.cs). -->
        <Grid x:Name="LimitLine" Height="3" Margin="10,0,10,-5" VerticalAlignment="Bottom" IsVisible="False" ColumnDefinitions="1*,1*">
            <Border Grid.ColumnSpan="2" CornerRadius="1.5" Background="#2A313C" />
            <Border x:Name="LimitFill" CornerRadius="1.5" Background="#F5C451" />
        </Grid>
        </Grid>
    </Border>
</Window>
