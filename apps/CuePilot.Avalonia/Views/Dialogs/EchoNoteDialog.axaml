<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CuePilot.Avalonia.Views.Dialogs.EchoNoteDialog"
        FontFamily="{StaticResource EchoFont}"
        FontSize="14"
        Width="620"
        Height="560"
        MinWidth="440"
        MinHeight="360"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <!-- A note for the topic knowledge base: a title and free text. -->
    <Border Margin="12"
            Padding="24,20,20,18"
            CornerRadius="18"
            Background="{DynamicResource EchoSurfaceBrush}"
            BorderBrush="{DynamicResource EchoBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 4 24 0 #59000000">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <StackPanel x:Name="Header" Orientation="Horizontal" Background="Transparent">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource EchoAccentBrush}" />
                <TextBlock x:Name="HeaderText"
                           Margin="10,0,0,0"
                           FontSize="18"
                           FontWeight="ExtraBold"
                           Foreground="{DynamicResource EchoTextBrush}" />
            </StackPanel>
            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EchoMutedBrush}" />
            <TextBox x:Name="TitleBox"
                     Grid.Row="2"
                     Margin="0,14,0,0"
                     Height="40"
                     FontSize="15"
                     VerticalContentAlignment="Center" />
            <TextBox x:Name="NoteTextBox"
                     Grid.Row="3"
                     Margin="0,10,0,0"
                     Padding="10,8"
                     FontSize="14.5"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <StackPanel Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Height="38"
                        MinWidth="110"
                        Padding="16,0"
                        IsCancel="True" />
                <Button x:Name="OkButton"
                        Classes="accent"
                        Height="38"
                        MinWidth="140"
                        Margin="8,0,0,0"
                        Padding="18,0"
                        FontSize="14" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
