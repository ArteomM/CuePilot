<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CuePilot.Avalonia.Views.Controls"
        xmlns:views="using:CuePilot.Avalonia.Views"
        x:Class="CuePilot.Avalonia.Views.MiniOverlayWindow"
        x:DataType="views:MiniOverlayWindow"
        FontFamily="{StaticResource EchoFont}"
        FontSize="14"
        UseLayoutRounding="True"
        Title="CuePilot"
        Icon="avares://CuePilot/Assets/cuepilot-icon.png"
        Width="760"
        Height="520"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen">
    <!-- Overlay windows stay in the night palette in both app themes: they float over other apps. -->
    <Window.Styles>
        <Style Selector="Button.overlayGhost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource EchoSoftTextBrush}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ListBoxItem.bubble">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Each new message rises softly into the dialog. -->
        <Style Selector="Border.bubble">
            <Style.Animations>
                <Animation Duration="0:0:0.32" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
    <Border Name="RootBorder" Margin="8" Background="#EB171B22" BorderBrush="#2A313C" BorderThickness="1" CornerRadius="20" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal">
                    <controls:EchoListeningBars x:Name="ListeningBars"
                                                Margin="4,0,2,0"
                                                VerticalAlignment="Center" />
                    <Button Name="CompactToggleButton"
                            Classes="overlayGhost"
                            Foreground="#E9EEF5"
                            FontWeight="ExtraBold"
                            Content="CuePilot ▾" />
                    <Button Margin="4,0,0,0"
                            Name="WhatToSayButton"
                            Classes="overlayGhost"
                            Content="Что сказать" />
                    <Button Margin="4,0,0,0"
                            Name="TopWhatShouldISayButton"
                            Classes="overlayGhost"
                            Content="Что спросить" />
                    <Button Margin="4,0,0,0"
                            Name="FollowUpQuestionButton"
                            Classes="overlayGhost"
                            Content="Уточняющие вопросы" />
                    <Button Margin="4,0,0,0"
                            Name="RecapButton"
                            Classes="overlayGhost"
                            Content="Кратко" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Name="OverlayStatusText"
                           VerticalAlignment="Center"
                           Foreground="#9AA5B5"
                           TextTrimming="CharacterEllipsis"
                           Text="..." />
                <Button Grid.Column="2"
                        Margin="4,0,4,0"
                        Name="OpenMainButton"
                        Classes="overlayGhost"
                        Content="↗" />
                <TextBlock Grid.Column="3"
                           Name="HotkeyHintText"
                           VerticalAlignment="Center"
                           Foreground="#9AA5B5"
                           Text="Ctrl+/" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0" Name="PromptRow" ColumnDefinitions="*,Auto">
                <Border CornerRadius="12" BorderBrush="#2A313C" BorderThickness="1" Background="#CC0E1116" Padding="0">
                    <TextBox Name="OverlayPromptText"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,8"
                             Foreground="#E9EEF5"
                             CaretBrush="#5EF0C1"
                             Text="Ask anything about your conversation"
                             VerticalContentAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <!-- Глубокий режим переехал в настройки; переключатель оставлен скрытым для кода. -->
                    <ToggleButton Name="SmartToggle" IsVisible="False" Content="Smart" />
                    <Button Name="WhatShouldISayButton"
                            Classes="accent"
                            MinWidth="110"
                            Height="38"
                            Content="Спросить" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Name="ConversationPanel"
                    Margin="0,10,0,0"
                    Padding="10"
                    CornerRadius="14"
                    BorderBrush="#2A313C"
                    BorderThickness="1"
                    Background="#990E1116">
                <Grid RowDefinitions="*,Auto">
                    <ListBox Name="OverlayConversationList"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ItemsSource="{Binding ConversationItems}"
                             controls:ItemContainer.Classes="bubble"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:OverlayConversationItem">
                                <Border Classes="bubble"
                                        Padding="14,10"
                                        CornerRadius="{Binding BubbleCornerRadius}"
                                        MaxWidth="520"
                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                        BorderBrush="{Binding BubbleBorder}"
                                        BorderThickness="1"
                                        Background="{Binding BubbleBackground}">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}"
                                                   Foreground="{Binding RoleBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold" />
                                        <SelectableTextBlock Text="{Binding Message}"
                                                             Foreground="{Binding MessageBrush}"
                                                             FontSize="14"
                                                             LineHeight="20"
                                                             TextWrapping="Wrap"
                                                             Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EchoThinkingDots x:Name="ThinkingDots"
                                               Grid.Row="1"
                                               Margin="6,2,0,2"
                                               HorizontalAlignment="Left"
                                               IsVisible="False" />
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Name="CompactAnswerPanel"
                    IsVisible="False"
                    Margin="0,10,0,0"
                    Padding="12,8"
                    CornerRadius="14"
                    BorderBrush="#2A313C"
                    BorderThickness="1"
                    Background="#CC0E1116">
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Name="CompactAnswerText"
                                         Foreground="#E9EEF5"
                                         TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="4"
                       Name="OverlayStatsText"
                       Margin="2,8,0,0"
                       Foreground="#9AA5B5"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Text="" />
        </Grid>
    </Border>
</Window>
