<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- The macOS build (Replio.app) passes -p:ReplioMac=true; WASAPI code is behind #if WINDOWS. -->
    <TargetFramework Condition="'$(ReplioMac)' == 'true'">net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.4</Version>
    <Company>ИП Макаров Артём Павлович</Company>
    <Copyright>© 2026 ИП Макаров Артём Павлович</Copyright>
    <Description>Replio — запись и распознавание речи</Description>
    <AssemblyTitle>Replio — запись и распознавание речи</AssemblyTitle>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <Product>Replio</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="1.10.0" />
  </ItemGroup>

</Project>
