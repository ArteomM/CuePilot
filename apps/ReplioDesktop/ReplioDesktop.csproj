<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>replio-favicon.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <Company>ИП Макаров Артём Павлович</Company>
    <Copyright>© 2026 ИП Макаров Артём Павлович</Copyright>
    <Description>Replio — ИИ-помощник для встреч</Description>
    <AssemblyTitle>Replio — ИИ-помощник для встреч</AssemblyTitle>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <InformationalVersion>1.1.2</InformationalVersion>
    <Product>Replio</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Content Include="replio-favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="replio-icon.png" />
    <Resource Include="replio-icon.png" />
    <Resource Include="replio-favicon.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Mini screenshots of the help window: <page>-dark.png and <page>-light.png, taken on demo data. -->
    <Resource Include="Assets\Help\*.png" />
    <Content Include="Assets\Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
