<Window x:Class="ReplioDesktop.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReplioDesktop.Views.Controls"
        FontFamily="{StaticResource EchoFont}"
        Width="860"
        Height="620"
        MinWidth="640"
        MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <!-- «Справка»: short pages with a mini screenshot each, instead of one long text. DataContext: MainViewModel. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="HelpNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource EchoSoftTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EchoHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EchoAccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EchoAccentSoftBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource EchoTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            CornerRadius="18"
            Background="{DynamicResource EchoSurfaceBrush}"
            BorderBrush="{DynamicResource EchoBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: drag to move, × to close. -->
            <Grid Background="Transparent" Margin="22,16,14,8" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource EchoAccentBrush}" />
                    <TextBlock Margin="10,0,0,0"
                               FontSize="17"
                               FontWeight="ExtraBold"
                               Foreground="{DynamicResource EchoTextBrush}"
                               Text="{Binding L[HelpWindowTitle]}" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Style="{StaticResource EchoGhostButtonStyle}"
                        ToolTip="{Binding L[HelpClose]}"
                        Click="CloseButton_OnClick">
                    <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource EchoSoftTextBrush}" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="14,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="TopicList"
                         Margin="0,4,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding HelpTopics}"
                         SelectedItem="{Binding SelectedHelpTopic, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource HelpNavItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="13.5" TextWrapping="Wrap" Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Margin="18,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="21"
                               FontWeight="ExtraBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource EchoTextBrush}"
                               Text="{Binding SelectedHelpTopic.Title}" />
                    <Border x:Name="ImageFrame"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="6"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            ToolTip="{Binding L[HelpZoomHint]}"
                            MouseLeftButtonUp="ImageFrame_OnMouseLeftButtonUp"
                            CornerRadius="12"
                            Background="{DynamicResource EchoSurfaceAltBrush}"
                            BorderBrush="{DynamicResource EchoCardBorderBrush}"
                            BorderThickness="1">
                        <Image x:Name="TopicImage"
                               MaxHeight="190"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <controls:MarkdownView x:Name="TopicText"
                                           Grid.Row="2"
                                           Margin="-4,10,0,0"
                                           FontSize="14"
                                           VerticalScrollBarVisibility="Auto"
                                           Markdown="{Binding SelectedHelpTopic.Markdown}" />
                    <WrapPanel Grid.Row="3"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsAgentsHelpTopic, Converter={StaticResource BoolToVisibility}}">
                        <Button Height="34" Padding="14,0" Margin="0,0,8,6" Style="{StaticResource EchoAccentButtonStyle}"
                                Command="{Binding CopyMcpCommandCommand}" Content="{Binding L[HelpCopyMcp]}" />
                        <Button Height="34" Padding="14,0" Margin="0,0,8,6" Style="{StaticResource EchoButtonStyle}"
                                Command="{Binding OpenAgentsGuideCommand}" Content="{Binding L[HelpOpenAgents]}" />
                        <TextBlock Margin="4,0,0,6" VerticalAlignment="Center" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding HelpFeedback}" />
                    </WrapPanel>
                </Grid>
            </Grid>

            <!-- Footer: page counter and Back / Next. -->
            <Grid Grid.Row="2" Margin="24,10,22,18">
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource EchoMutedBrush}" Text="{Binding HelpCounterText}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Height="36" MinWidth="110" Padding="16,0" Style="{StaticResource EchoButtonStyle}"
                            Command="{Binding PreviousHelpTopicCommand}" Content="{Binding L[HelpPrev]}" />
                    <Button Height="36" MinWidth="110" Margin="8,0,0,0" Padding="16,0" Style="{StaticResource EchoAccentButtonStyle}"
                            Command="{Binding NextHelpTopicCommand}" Content="{Binding L[HelpNext]}" />
                </StackPanel>
            </Grid>

            <!-- The picture enlarged over the whole window: a click or Esc closes it. -->
            <Border x:Name="ZoomLayer"
                    Grid.RowSpan="3"
                    CornerRadius="18"
                    Padding="14"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Background="{DynamicResource EchoSurfaceBrush}"
                    ToolTip="{Binding L[HelpZoomClose]}"
                    MouseLeftButtonUp="ZoomLayer_OnMouseLeftButtonUp">
                <Image x:Name="ZoomImage"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Grid>
    </Border>
</Window>
